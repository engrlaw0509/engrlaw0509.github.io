---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Page name for <title>; the studio name is appended. */
  bare?: boolean;
}

const { title, description, bare = false } = Astro.props;
const fullTitle = bare ? title : `${title} — LMI Automata Labs`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;

const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/services/', label: 'Services' },
  { href: '/contact/', label: 'Contact' },
];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Lawrence Ignacio" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="LMI Automata Labs" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
  />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <div class="sheet">
    <header class="masthead">
      <a class="brand" href="/">LMI Automata Labs</a>
      <nav aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <hr class="rule" />
  </div>

  <main id="main">
    <slot />
  </main>

  <div class="sheet">
    <hr class="rule" />
    <footer>
      <div class="foot-brand">
        <span class="foot-name">LMI Automata Labs</span>
        <span class="foot-note">Business software for Philippine companies. Metro Manila.</span>
      </div>
      <nav class="foot-links" aria-label="Footer">
        <a href="/work/">Work</a>
        <a href="/services/">Services</a>
        <a href="/contact/">Contact</a>
        <a href="mailto:lmiautomatalabs@gmail.com">lmiautomatalabs@gmail.com</a>
      </nav>
    </footer>
  </div>

  <style>
    .masthead {
      padding-block: 1.1rem;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem 1.5rem;
      flex-wrap: wrap;
      font-family: var(--f-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    .brand {
      color: var(--ink);
      font-weight: 500;
      letter-spacing: 0.1em;
      text-decoration: none;
    }
    .brand:hover { color: var(--accent); }
    .masthead nav { display: flex; gap: 1.25rem; flex-wrap: wrap; }
    .masthead nav a { color: var(--ink-3); text-decoration: none; }
    .masthead nav a:hover { color: var(--accent); }
    .masthead nav a[aria-current='page'] { color: var(--ink); }

    footer {
      padding-block: 2.25rem 3rem;
      display: flex;
      justify-content: space-between;
      gap: 1.5rem 2rem;
      flex-wrap: wrap;
    }
    .foot-brand { display: grid; gap: 0.3rem; }
    .foot-name {
      font-family: var(--f-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .foot-note { font-size: 0.9375rem; color: var(--ink-3); }
    .foot-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 1.25rem;
      font-family: var(--f-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      align-items: flex-start;
    }
    .foot-links a { color: var(--ink-3); text-decoration: none; }
    .foot-links a:hover { color: var(--accent); }
  </style>
</body>
</html>
