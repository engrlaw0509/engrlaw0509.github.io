---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { getProjects, fmtDayYear } from '../lib/projects';

interface Props {
  title: string;
  description: string;
  /** Page name for <title>; the studio name is appended. */
  bare?: boolean;
  /**
   * Site-root-relative path to the image shown when this page is shared on
   * Facebook, LinkedIn, Messenger or Viber. Project pages pass their own
   * screenshot; everything else gets the branded card.
   */
  ogImage?: string;
}

const { title, description, bare = false, ogImage = '/og.png' } = Astro.props;
const fullTitle = bare ? title : `${title} — LMI Automata Labs`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Social crawlers do not resolve relative image paths — this must be absolute.
const ogImageUrl = new URL(ogImage, Astro.site).href;
const path = Astro.url.pathname;

const nav = [
  { href: '/work/', label: 'Products' },
  { href: '/services/', label: 'Services' },
  { href: '/changelog/', label: 'Changelog' },
  { href: '/contact/', label: 'Contact' },
];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));

const projects = await getProjects();
// The build date, as a Manila calendar day (Manila is UTC+8, no DST).
const built = fmtDayYear(new Date(Date.now() + 8 * 3600_000));

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'LMI Automata Labs',
  url: 'https://www.lmiautomatalabs.com',
  logo: 'https://www.lmiautomatalabs.com/brand/mark-180.png',
  email: 'lmiautomatalabs@gmail.com',
  address: { '@type': 'PostalAddress', addressRegion: 'Metro Manila', addressCountry: 'PH' },
  sameAs: [
    'https://www.linkedin.com/in/lawrence-ignacio-97ba0013a/',
    'https://github.com/engrlaw0509',
  ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

  <!-- Before anything paints:
       1. The bare apex is served by GitHub Pages, which has no /api — so the
          enquiry form and live status cannot work there. Send it to www.
       2. Apply a remembered theme, so a light-theme reader never sees a dark
          flash. Storage can throw (private mode, blocked site data); dark is
          the fallback either way. -->
  <script is:inline>
    (function () {
      if (location.hostname === 'lmiautomatalabs.com') {
        location.replace('https://www.lmiautomatalabs.com' + location.pathname + location.search + location.hash);
        return;
      }
      var root = document.documentElement;
      root.classList.add('js');
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') root.dataset.theme = t;
      } catch (e) {}
    })();
  </script>

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Lawrence Ignacio" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" sizes="64x64" href="/brand/mark-64.png" />
  <link rel="apple-touch-icon" href="/brand/mark-180.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#05080F" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="LMI Automata Labs" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={description} />
  <meta property="og:locale" content="en_PH" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImageUrl} />

  <Font cssVariable="--font-geist" preload />
  <Font cssVariable="--font-geist-mono" />

  <script type="application/ld+json" set:html={JSON.stringify(org)} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="masthead">
    <div class="wrap masthead-inner">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">LMI Automata Labs</span>
      </a>

      <nav class="nav" aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>

      <div class="actions">
        <button class="icon-btn theme-toggle" type="button" data-theme-toggle
          aria-label="Switch to light theme">
          <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
            <path d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"
              stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"
              stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
          </svg>
        </button>

        <a class="btn btn-sm cta" href="/contact/">
          Start a project
          <svg class="arrow" viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
            <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>

        <!-- A <details> menu opens and closes with no script at all. -->
        <details class="menu">
          <summary class="icon-btn" aria-label="Menu">
            <svg class="i-open" viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <svg class="i-close" viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
              <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </summary>
          <div class="menu-panel">
            <nav aria-label="Main, mobile">
              {nav.map((item) => (
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
                    <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6"
                      stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              ))}
            </nav>
            <a class="btn" href="/contact/">Start a project</a>
          </div>
        </details>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-name">LMI Automata Labs</span>
        </a>
        <p class="footer-note">
          Software and automation for Philippine businesses — point of sale, payroll,
          client portals, and the integrations between them.
        </p>
        <p class="footer-place">Metro Manila, Philippines</p>
        <!-- Shown only when every live product has just passed its health check. -->
        <p class="footer-status" data-status-summary hidden>
          <span class="status is-live is-verified">
            <span class="status-dot" aria-hidden="true"></span>
            <span class="status-text">All systems operational</span>
          </span>
        </p>
      </div>

      <nav class="footer-col" aria-label="Products">
        <span class="footer-h">Products</span>
        {projects.map((p) => <a href={`/work/${p.id}/`}>{p.data.name}</a>)}
      </nav>

      <nav class="footer-col" aria-label="Company">
        <span class="footer-h">Company</span>
        <a href="/services/">Services</a>
        <a href="/changelog/">Changelog</a>
        <a href="/contact/">Contact</a>
      </nav>

      <div class="footer-col">
        <span class="footer-h">Get in touch</span>
        <a href="mailto:lmiautomatalabs@gmail.com">lmiautomatalabs@gmail.com</a>
        <a href="https://www.linkedin.com/in/lawrence-ignacio-97ba0013a/" rel="noopener">LinkedIn</a>
        <a href="https://github.com/engrlaw0509" rel="noopener">GitHub</a>
      </div>
    </div>
    <div class="wrap footer-base">
      <span>&copy; {new Date().getFullYear()} LMI Automata Labs</span>
      <span>Updated {built} &middot; Built in Manila</span>
    </div>
  </footer>

  <script>
    const root = document.documentElement;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---------- theme toggle ---------- */
    const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    const themeMeta = document.querySelector('meta[name="theme-color"]');
    const current = () => (root.dataset.theme === 'light' ? 'light' : 'dark');
    const syncTheme = () => {
      const t = current();
      toggle?.setAttribute('aria-label', t === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
      themeMeta?.setAttribute('content', t === 'light' ? '#FFFFFF' : '#05080F');
    };
    toggle?.addEventListener('click', () => {
      // Decide inside the update, not at click time: a view transition runs it
      // a frame later, and two quick clicks must toggle twice, not once.
      const apply = () => {
        const next = current() === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch { /* not remembered; still applied */ }
        syncTheme();
      };
      // Cross-fade the whole page between themes where the browser can.
      if (!reduced && 'startViewTransition' in document) document.startViewTransition(apply);
      else apply();
    });
    syncTheme();

    /* ---------- mobile menu: close on outside tap or Escape ---------- */
    const menu = document.querySelector<HTMLDetailsElement>('details.menu');
    if (menu) {
      document.addEventListener('click', (e) => {
        if (menu.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    }

    /* ---------- cursor spotlight on .spot cards (mouse only) ---------- */
    let frame = 0;
    let last: PointerEvent | null = null;
    document.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      last = e;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const el = last?.target instanceof Element ? last.target.closest<HTMLElement>('.spot') : null;
        if (!el || !last) return;
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', `${last.clientX - r.left}px`);
        el.style.setProperty('--my', `${last.clientY - r.top}px`);
      });
    }, { passive: true });

    /* ---------- count-up numbers ----------
       The HTML already holds the final figure, so with no script, no observer
       or reduced motion, the right number is simply there. */
    const counters = document.querySelectorAll<HTMLElement>('[data-count]');
    if (counters.length && !reduced && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          io.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const end = Number(el.dataset.count);
          if (!Number.isFinite(end)) continue;
          const t0 = performance.now();
          const tick = (t: number) => {
            const k = Math.min(1, (t - t0) / 1400);
            el.textContent = Math.round(end * (1 - Math.pow(1 - k, 3))).toLocaleString('en-US');
            if (k < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      }, { threshold: 0.6 });
      counters.forEach((c) => io.observe(c));
    }

    /* ---------- live status ----------
       server.mjs health-checks each live product and caches the answer for a
       minute. Only a PASSING check changes anything on the page. Where there is
       no /api (the Pages mirror, `astro dev`), the fetch fails and the
       build-time text stays. */
    const pills = document.querySelectorAll<HTMLElement>('[data-probe]');
    const summary = document.querySelector<HTMLElement>('[data-status-summary]');
    if (pills.length || summary) {
      fetch('/api/status', { headers: { accept: 'application/json' } })
        .then((r) => (r.ok ? r.json() : null))
        .then((s: { checkedAt: string; products: Record<string, { ok: boolean }> } | null) => {
          if (!s?.products) return;
          const secs = Math.max(0, Math.round((Date.now() - Date.parse(s.checkedAt)) / 1000));
          const ago = secs < 60 ? `${secs}s ago` : `${Math.round(secs / 60)} min ago`;
          pills.forEach((el) => {
            const p = s.products[el.dataset.probe ?? ''];
            if (!p?.ok) return;
            el.classList.add('is-verified');
            const text = el.querySelector('.status-text');
            if (text) text.textContent = 'Live now';
            el.title = `Health check passed ${ago}`;
          });
          const all = Object.values(s.products);
          if (summary && all.length && all.every((p) => p.ok)) summary.hidden = false;
        })
        .catch(() => { /* leave the build-time text */ });
    }
  </script>

  <style>
    /* ---------------- masthead ---------------- */
    .masthead {
      position: sticky;
      top: 0;
      z-index: 40;
      view-transition-name: masthead;
      background: color-mix(in srgb, var(--bg) 74%, transparent);
      -webkit-backdrop-filter: blur(14px) saturate(150%);
      backdrop-filter: blur(14px) saturate(150%);
      border-bottom: 1px solid var(--line);
    }
    .masthead-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-height: 4rem;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
      color: var(--ink);
      font-family: var(--f-display);
      font-weight: 650;
      font-size: 1rem;
      letter-spacing: -0.025em;
      flex: none;
    }
    .brand:hover { color: var(--ink); }
    /* A background, not an <img>, so only the mark for the active theme is
       ever downloaded. The name beside it is the accessible label. */
    .brand-mark {
      width: 46px;
      height: 32px;
      flex: none;
      background: url('/brand/mark-wide-light.png') center / contain no-repeat;
    }
    :global([data-theme='light']) .brand-mark { background-image: url('/brand/mark-wide.png'); }
    @media (max-width: 22rem) { .masthead .brand-name { display: none; } }

    .nav {
      display: none;
      align-items: center;
      gap: 0.25rem;
      font-size: 0.9375rem;
      font-weight: 500;
    }
    .nav a {
      color: var(--ink-2);
      text-decoration: none;
      padding: 0.45rem 0.8rem;
      border-radius: var(--r-pill);
      transition: color 160ms var(--ease), background-color 160ms var(--ease);
    }
    .nav a:hover { color: var(--ink); background: var(--surface-2); }
    .nav a[aria-current='page'] { color: var(--ink); background: var(--surface-2); }
    @media (min-width: 52rem) { .nav { display: flex; } }

    .actions { display: flex; align-items: center; gap: 0.5rem; }
    .cta { display: none; }
    @media (min-width: 36rem) { .cta { display: inline-flex; } }

    .icon-btn {
      display: inline-grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: var(--r-pill);
      border: 1px solid var(--line);
      background: var(--surface);
      color: var(--ink-2);
      cursor: pointer;
      transition: color 160ms var(--ease), border-color 160ms var(--ease), background-color 160ms var(--ease);
    }
    .icon-btn:hover { color: var(--ink); border-color: var(--line-2); background: var(--surface-2); }

    /* The toggle needs script; hide it until the head script has run. */
    .theme-toggle { display: none; }
    :global(.js) .theme-toggle { display: inline-grid; }
    .theme-toggle .i-moon { display: none; }
    :global([data-theme='light']) .theme-toggle .i-sun { display: none; }
    :global([data-theme='light']) .theme-toggle .i-moon { display: block; }

    /* ---------------- mobile menu ---------------- */
    .menu { position: static; }
    .menu summary { list-style: none; }
    .menu summary::-webkit-details-marker { display: none; }
    .menu .i-close { display: none; }
    .menu[open] .i-open { display: none; }
    .menu[open] .i-close { display: block; }
    @media (min-width: 52rem) { .menu { display: none; } }

    .menu-panel {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      display: grid;
      gap: 1rem;
      padding: 0.75rem var(--gutter) 1.25rem;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-lg);
      animation: menu-in 220ms var(--ease);
    }
    @keyframes menu-in { from { opacity: 0; transform: translateY(-6px); } }
    @media (prefers-reduced-motion: reduce) { .menu-panel { animation: none; } }
    .menu-panel nav { display: grid; }
    .menu-panel nav a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.95rem 0.25rem;
      border-bottom: 1px solid var(--line);
      color: var(--ink);
      text-decoration: none;
      font-size: 1.0625rem;
      font-weight: 500;
    }
    .menu-panel nav a svg { color: var(--ink-3); }
    .menu-panel nav a[aria-current='page'] { color: var(--accent); }

    /* ---------------- footer ---------------- */
    .footer {
      position: relative;
      border-top: 1px solid var(--line);
      background:
        radial-gradient(60% 120% at 50% 0%, var(--glow-a), transparent 60%),
        var(--bg-2);
    }
    .footer-inner {
      display: grid;
      gap: 2.25rem;
      padding-block: clamp(3rem, 6vw, 4.5rem) 2.25rem;
    }
    @media (min-width: 40rem) { .footer-inner { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 60rem) {
      .footer-inner { grid-template-columns: 2.2fr 1fr 1fr 1.3fr; gap: 3rem; }
    }
    .footer-brand { display: grid; gap: 0.75rem; align-content: start; justify-items: start; }
    .footer-note { color: var(--ink-2); font-size: 0.9375rem; max-width: 40ch; }
    .footer-place {
      font-family: var(--f-mono);
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      color: var(--ink-3);
    }
    .footer-status { margin-top: 0.25rem; }

    .footer-col { display: grid; gap: 0.65rem; align-content: start; }
    .footer-h {
      font-family: var(--f-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-3);
      margin-bottom: 0.2rem;
    }
    .footer-col a {
      color: var(--ink-2);
      text-decoration: none;
      font-size: 0.9375rem;
      justify-self: start;
      overflow-wrap: anywhere;
    }
    .footer-col a:hover { color: var(--ink); }

    .footer-base {
      position: relative;
      display: flex;
      justify-content: space-between;
      gap: 0.5rem 1rem;
      flex-wrap: wrap;
      padding-block: 1.25rem 2rem;
      font-family: var(--f-mono);
      font-size: 0.75rem;
      color: var(--ink-3);
    }
    /* The rule stops at the content edges, like everything above it. */
    .footer-base::before {
      content: '';
      position: absolute;
      top: 0;
      left: var(--gutter);
      right: var(--gutter);
      height: 1px;
      background: var(--line);
    }
  </style>
</body>
</html>
