---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Page name for <title>; the studio name is appended. */
  bare?: boolean;
  /**
   * Site-root-relative path to the image shown when this page is shared on
   * Facebook, LinkedIn, Messenger or Viber. Project pages pass their own
   * screenshot; everything else gets the branded card.
   */
  ogImage?: string;
}

const { title, description, bare = false, ogImage = '/og.png' } = Astro.props;
const fullTitle = bare ? title : `${title} — LMI Automata Labs`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Social crawlers do not resolve relative image paths — this must be absolute.
const ogImageUrl = new URL(ogImage, Astro.site).href;
const path = Astro.url.pathname;

const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/services/', label: 'Services' },
  { href: '/contact/', label: 'Contact' },
];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Lawrence Ignacio" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" sizes="64x64" href="/brand/mark-64.png" />
  <link rel="apple-touch-icon" href="/brand/mark-180.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#145C94" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="LMI Automata Labs" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={description} />
  <meta property="og:locale" content="en_PH" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImageUrl} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
  />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="masthead">
    <div class="wrap masthead-inner">
      <a class="brand" href="/">
        <picture>
          <source srcset="/brand/mark-wide-light.png" media="(prefers-color-scheme: dark)" />
          <img class="brand-mark" src="/brand/mark-wide.png" height="34" alt="" />
        </picture>
        <span class="brand-name">LMI Automata Labs</span>
      </a>

      <nav class="masthead-nav" aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
        <a class="btn masthead-cta" href="/contact/">Get in touch</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <span class="footer-name">
          <picture>
            <source srcset="/brand/mark-wide-light.png" media="(prefers-color-scheme: dark)" />
            <img src="/brand/mark-wide.png" height="26" alt="" />
          </picture>
          LMI Automata Labs
        </span>
        <p class="footer-note">
          Business software for Philippine companies — point of sale, payroll,
          client portals, and the integrations between them.
        </p>
        <p class="footer-place">Metro Manila, Philippines</p>
      </div>

      <nav class="footer-col" aria-label="Pages">
        <span class="footer-h">Pages</span>
        <a href="/work/">Work</a>
        <a href="/services/">Services</a>
        <a href="/contact/">Contact</a>
      </nav>

      <div class="footer-col">
        <span class="footer-h">Get in touch</span>
        <a href="mailto:lmiautomatalabs@gmail.com">lmiautomatalabs@gmail.com</a>
        <a href="https://www.linkedin.com/in/lawrence-ignacio-97ba0013a/" rel="noopener">LinkedIn</a>
        <a href="https://github.com/engrlaw0509" rel="noopener">GitHub</a>
      </div>
    </div>
    <div class="wrap footer-base">
      <span>&copy; {new Date().getFullYear()} LMI Automata Labs</span>
      <span>Built in Manila</span>
    </div>
  </footer>

  <style>
    /* ---------------- masthead ---------------- */
    .masthead {
      position: sticky;
      top: 0;
      z-index: 40;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }
    .masthead-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem 1.5rem;
      padding-block: 0.85rem;
      flex-wrap: wrap;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
      color: var(--ink);
      font-family: var(--f-display);
      font-weight: 700;
      font-size: 1rem;
      letter-spacing: -0.02em;
    }
    .brand-mark {
      height: 34px;
      width: auto;
      flex: none;
    }
    .brand:hover .brand-name { color: var(--accent); }

    .masthead-nav {
      display: flex;
      align-items: center;
      gap: 0.4rem 1.5rem;
      flex-wrap: wrap;
      font-size: 0.9375rem;
      font-weight: 500;
    }
    .masthead-nav > a:not(.btn) {
      color: var(--ink-2);
      text-decoration: none;
      padding-block: 0.25rem;
    }
    .masthead-nav > a:not(.btn):hover { color: var(--ink); }
    .masthead-nav > a[aria-current='page'] { color: var(--accent); }
    .masthead-cta { padding: 0.55rem 1rem; font-size: 0.875rem; }
    @media (max-width: 26rem) { .masthead-cta { display: none; } }

    /* The header has to wrap on a phone. Spread the links across the full row
       so it reads as a deliberate nav bar instead of an accidental overflow. */
    @media (max-width: 34rem) {
      .masthead-inner { gap: 0.6rem; padding-block: 0.7rem; }
      .masthead-nav { width: 100%; justify-content: space-between; gap: 0.5rem; }
    }

    /* ---------------- footer ---------------- */
    .footer {
      border-top: 1px solid var(--line);
      background: var(--bg-tint);
      margin-top: clamp(3rem, 7vw, 5rem);
    }
    .footer-inner {
      display: grid;
      gap: 2.25rem;
      padding-block: clamp(2.5rem, 5vw, 3.5rem) 2rem;
    }
    @media (min-width: 48rem) {
      .footer-inner { grid-template-columns: 2fr 1fr 1.2fr; gap: 3rem; }
    }
    .footer-brand { display: grid; gap: 0.6rem; align-content: start; }
    .footer-name {
      font-family: var(--f-display);
      font-weight: 700;
      font-size: 1.0625rem;
      letter-spacing: -0.02em;
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
    }
    .footer-name img {
      height: 26px;
      width: auto;
      flex: none;
    }
    .footer-note { color: var(--ink-2); font-size: 0.9375rem; max-width: 42ch; }
    .footer-place {
      font-family: var(--f-mono);
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      color: var(--ink-3);
    }

    .footer-col { display: grid; gap: 0.6rem; align-content: start; }
    .footer-h {
      font-family: var(--f-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
    .footer-col a {
      color: var(--ink-2);
      text-decoration: none;
      font-size: 0.9375rem;
      justify-self: start;
    }
    .footer-col a:hover { color: var(--accent); }

    .footer-base {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      padding-block: 1.25rem 2rem;
      border-top: 1px solid var(--line);
      font-family: var(--f-mono);
      font-size: 0.75rem;
      color: var(--ink-3);
    }
  </style>
</body>
</html>
