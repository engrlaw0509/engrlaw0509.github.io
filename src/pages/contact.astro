---
import Base from '../layouts/Base.astro';

const email = 'lmiautomatalabs@gmail.com';
const subject = encodeURIComponent('Project enquiry');
const body = encodeURIComponent(
  [
    'Hello,',
    '',
    'My business: ',
    'What we do: ',
    '',
    'The part of the week that goes wrong:',
    '',
    '',
    'What we use now (spreadsheets, apps, paper):',
    '',
    '',
    'Thanks,',
  ].join('\n'),
);

const prompts = [
  'What takes the longest every week, and who does it?',
  'What gets typed in more than once?',
  'What breaks when the person who normally does it is away?',
  'What do you wish you could see without asking anyone?',
];

const channels = [
  { label: 'Email', value: email, href: `mailto:${email}`, note: 'Usually answered same day' },
  {
    label: 'LinkedIn',
    value: 'Lawrence Ignacio',
    href: 'https://www.linkedin.com/in/lawrence-ignacio-97ba0013a/',
    note: 'Connect or message',
  },
  {
    label: 'GitHub',
    value: 'engrlaw0509',
    href: 'https://github.com/engrlaw0509',
    note: 'Code and open work',
  },
];
---

<Base
  title="Contact"
  description="Talk to LMI Automata Labs about software for your business. Metro Manila, Philippines."
>
  <section class="page-head">
    <div class="wrap head-inner">
      <p class="eyebrow">Start here</p>
      <h1 class="h-xl head-title">Tell us where the week goes wrong.</h1>
      <p class="lede">
        You do not need a specification, a budget, or the right words for it. The most
        useful first message describes one job that takes too long and who has to do it.
      </p>
      <div class="btn-row">
        <a class="btn" href={`mailto:${email}?subject=${subject}&body=${body}`}>
          Email us
        </a>
        <a class="btn btn-ghost" href={`mailto:${email}`}>{email}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap contact-grid">
      <div class="card-surface panel">
        <h2 class="h-md">If you are not sure what to write</h2>
        <ul class="prompts">
          {prompts.map((p) => <li>{p}</li>)}
        </ul>
        <p class="after">
          Any one of those is enough to start. If it turns out software is not the answer,
          we will say so — that conversation costs you nothing either way.
        </p>
      </div>

      <div class="channels">
        {channels.map((c) => (
          <a class="card-surface channel" href={c.href} rel="noopener">
            <span class="channel-label">{c.label}</span>
            <span class="channel-value">{c.value}</span>
            <span class="channel-note">{c.note}</span>
          </a>
        ))}
        <p class="based">Based in Metro Manila. We work across the Philippines, and remotely for clients abroad.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head { padding-block: clamp(2.5rem, 6vw, 4.5rem) 0; }
  .head-inner { display: grid; gap: 1.2rem; justify-items: start; }
  .head-title { max-width: 18ch; }

  .contact-grid { display: grid; gap: 1.25rem; align-items: start; }
  @media (min-width: 58rem) { .contact-grid { grid-template-columns: 1.3fr 1fr; gap: 2rem; } }

  .panel { display: grid; gap: 1rem; }
  .prompts { margin: 0; padding: 0; list-style: none; display: grid; gap: 0; }
  .prompts li {
    padding-block: 0.85rem;
    border-top: 1px solid var(--line-soft);
    color: var(--ink-2);
  }
  .prompts li:first-child { border-top: 0; padding-top: 0; }
  .after { color: var(--ink-3); font-size: 0.9375rem; }

  .channels { display: grid; gap: 0.85rem; align-content: start; }
  .channel {
    display: grid;
    gap: 0.15rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .channel:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    box-shadow: var(--shadow);
  }
  .channel-label {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .channel-value {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    word-break: break-word;
  }
  .channel-note { font-size: 0.875rem; color: var(--ink-3); }
  .based { font-size: 0.875rem; color: var(--ink-3); margin-top: 0.35rem; }
</style>
