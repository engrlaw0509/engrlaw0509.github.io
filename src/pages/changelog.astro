---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import UpdateList from '../components/UpdateList.astro';
import { getProjects, allUpdates, fmtMonth } from '../lib/projects';

const projects = await getProjects();
const updates = allUpdates(projects);

// Group by calendar month, newest first. Keys are UTC like the dates themselves.
const months: { label: string; items: typeof updates }[] = [];
for (const u of updates) {
  const label = fmtMonth(u.date);
  const last = months.at(-1);
  if (last?.label === label) last.items.push(u);
  else months.push({ label, items: [u] });
}
---

<Base
  title="Changelog"
  description="What shipped, and when — across Croma MNL, Sentro, EA Builders and Kaha. Every product LMI Automata Labs builds is still being improved."
>
  <PageHead
    eyebrow="Changelog"
    title="What shipped, and when."
    lede={`Every product here is still being worked on. ${updates.length} changes across ${projects.length} products, newest first — written for the people who use them, not for the people who build them.`}
  >
    <ul class="legend rise" style="--d: 3">
      {projects.map((p) => (
        <li><a href={`/work/${p.id}/`}>{p.data.name}</a><span>{p.data.updates.length}</span></li>
      ))}
    </ul>
  </PageHead>

  <section class="section">
    <div class="wrap months">
      {months.map((m) => (
        <section class="month reveal" aria-labelledby={`m-${m.label.replace(/\s+/g, '-')}`}>
          <h2 class="month-h" id={`m-${m.label.replace(/\s+/g, '-')}`}>
            {m.label}
            <span class="month-n">{m.items.length}</span>
          </h2>
          <div class="card-surface month-list">
            <UpdateList items={m.items} showProject />
          </div>
        </section>
      ))}
    </div>
  </section>
</Base>

<style>
  .legend {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.4rem 0.35rem 0.8rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-2);
    background: var(--surface);
    font-size: 0.875rem;
  }
  .legend a { color: var(--ink); text-decoration: none; font-weight: 500; }
  .legend a:hover { color: var(--accent); }
  .legend span {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    color: var(--ink-3);
    background: var(--surface-2);
    border-radius: var(--r-pill);
    padding: 0.15rem 0.5rem;
  }

  .months { display: grid; gap: clamp(2.5rem, 5vw, 3.5rem); max-width: 60rem; }
  .month { display: grid; gap: 1rem; }
  @media (min-width: 60rem) {
    .months { max-width: none; }
    .month { grid-template-columns: 14rem minmax(0, 1fr); gap: 2.5rem; align-items: start; }
    .month-h { position: sticky; top: 6rem; }
  }
  .month-h {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.025em;
  }
  .month-n {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink-3);
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 0.12rem 0.5rem;
  }
  .month-list { padding: clamp(0.75rem, 2vw, 1.25rem) clamp(1rem, 2.5vw, 1.75rem); }
</style>
