---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
const liveCount = projects.filter((p) => p.data.status === 'production').length;

/** Explicitly chosen in the project's index.md — see `hero` in content.config.ts. */
const heroShot = projects.find((p) => p.data.hero && p.data.cover);

const services = [
  {
    title: 'Connect the systems you already pay for',
    body: 'Your point of sale, your accounting, your stock list — talking to each other, so a number typed once stops being typed three more times.',
  },
  {
    title: 'Take the manual steps out',
    body: 'The report somebody rebuilds by hand every Monday. The files emailed back and forth. Those can run themselves, including the parts that need reading and judgement.',
  },
  {
    title: 'Get off the spreadsheet',
    body: 'Move onto a proper system without closing for a day. Everything checked against the old records before you switch, and reversible until you are sure.',
  },
];
---

<Base
  title="Automate your business"
  description="LMI Automata Labs automates the work Philippine businesses do by hand — point of sale, payroll, client portals and the integrations between them. BIR-ready, e-wallet aware, and built to keep running when the connection drops."
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="eyebrow">Software studio &middot; Metro Manila</p>
      <h1 class="h-xl hero-title">Automate your <em>business</em>.</h1>
      <p class="lede hero-lede">
        We build the systems Philippine companies use every day &mdash; the POS at the
        counter, the payroll on Friday, the portal a client checks on a Sunday.
        <strong>Built here, for how business works here:</strong> receipts the BIR accepts,
        e&#8209;wallets counted properly, and everything still running when the internet drops.
      </p>
      <div class="btn-row hero-cta">
        <a class="btn" href="/contact/">Talk about your business</a>
        <a class="btn btn-ghost" href="/work/">See what we&rsquo;ve built</a>
      </div>

      {heroShot?.data.cover && (
        <div class="hero-shot">
          <div class="frame frame-lg">
            <div class="frame-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <Image
              src={heroShot.data.cover}
              alt={`${heroShot.data.name} — the dashboard an owner sees`}
              widths={[760, 1160, 1600]}
              sizes="(min-width: 78rem) 70rem, 94vw"
              loading="eager"
            />
          </div>
          <p class="hero-caption">
            {heroShot.data.name} &mdash; {heroShot.data.sector.toLowerCase()}
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- ============ METRICS ============ -->
  <section class="wrap band">
    <div class="metrics">
      <div>
        <span class="metric-n">{projects.length}</span>
        <span class="metric-l">Products built</span>
      </div>
      <div>
        <span class="metric-n">{liveCount}</span>
        <span class="metric-l">Running live</span>
      </div>
      <div>
        <span class="metric-n">3</span>
        <span class="metric-l">Industries</span>
      </div>
      <div>
        <span class="metric-n">PH</span>
        <span class="metric-l">BIR &amp; e&#8209;wallet ready</span>
      </div>
    </div>
  </section>

  <!-- ============ WORK ============ -->
  <section class="section" id="work">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The work</p>
        <h2 class="h-lg">Systems running real businesses</h2>
        <p class="lede">
          {liveCount} of these are in production today &mdash; taking payments, paying staff,
          and keeping owners out of spreadsheets.
        </p>
      </div>

      <div class="grid-featured">
        {featured.map((project) => <ProjectCard project={project} featured />)}
      </div>

      {rest.length > 0 && (
        <div class="grid-rest">
          {rest.map((project) => <ProjectCard project={project} />)}
        </div>
      )}

      <div class="btn-row section-foot">
        <a class="btn btn-ghost" href="/work/">All projects</a>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2 class="h-lg">Not everything needs a new system</h2>
        <p class="lede">
          Often the software is already there and the problem is that none of it talks.
          That work is usually faster and cheaper than building something new.
        </p>
      </div>

      <div class="svc-grid">
        {services.map((s, i) => (
          <div class="card-surface svc">
            <span class="svc-n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h-md svc-title">{s.title}</h3>
            <p class="muted">{s.body}</p>
          </div>
        ))}
      </div>

      <div class="btn-row section-foot">
        <a class="btn btn-ghost" href="/services/">How this works</a>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section">
    <div class="wrap">
      <div class="cta">
        <p class="eyebrow">Next step</p>
        <h2 class="h-lg">Tell us where the day breaks.</h2>
        <p class="lede cta-lede">
          The best place to start is the part of the week everyone dreads &mdash; closing the
          the POS, chasing timesheets, rebuilding the same report. Describe that, and we will
          tell you honestly whether it is worth building.
        </p>
        <div class="btn-row">
          <a class="btn" href="/contact/">Start a conversation</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------------- hero ---------------- */
  .hero {
    position: relative;
    padding-block: clamp(2.75rem, 7vw, 5rem) 0;
    overflow: hidden;
  }
  /* A soft wash behind the hero — depth without a gradient slab. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 34rem;
    background: radial-gradient(70% 55% at 50% 0%, var(--accent-wash), transparent 72%);
    pointer-events: none;
  }
  .hero-inner { position: relative; display: grid; justify-items: center; text-align: center; gap: 1.35rem; }
  .hero-title { max-width: 18ch; }
  .hero-title em { font-style: normal; color: var(--accent); }
  .hero-lede { max-width: 56ch; }
  .hero-cta { justify-content: center; margin-top: 0.35rem; }

  .hero-shot { width: 100%; margin-top: clamp(2.25rem, 5vw, 3.5rem); display: grid; gap: 0.75rem; }
  .hero-caption {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* ---------------- metrics band ---------------- */
  .band { padding-top: clamp(2rem, 4vw, 3rem); }

  /* ---------------- work ---------------- */
  .grid-featured { display: grid; gap: clamp(2.25rem, 4.5vw, 3.25rem); }
  @media (min-width: 62rem) {
    .grid-featured { grid-template-columns: repeat(auto-fill, minmax(min(100%, 27rem), 1fr)); }
  }
  .grid-rest {
    display: grid;
    gap: clamp(2.25rem, 4.5vw, 3.25rem) 2rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    margin-top: clamp(2.25rem, 4.5vw, 3.25rem);
  }
  .section-foot { margin-top: clamp(2.25rem, 4.5vw, 3rem); }

  /* ---------------- services ---------------- */
  .svc-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }
  .svc { display: grid; gap: 0.55rem; align-content: start; }
  .svc-n {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .svc-title { font-size: clamp(1.125rem, 1.05rem + 0.4vw, 1.3125rem); }

  /* ---------------- cta ---------------- */
  .cta {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.1rem;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.25rem, 4vw, 3rem);
    background:
      radial-gradient(90% 120% at 50% 0%, var(--accent-wash), transparent 70%),
      var(--bg-tint);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .cta-lede { max-width: 58ch; }
</style>
