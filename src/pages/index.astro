---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
const liveCount = projects.filter((p) => p.data.status === 'production').length;

const services = [
  {
    title: 'Connect the systems you already pay for',
    body: 'Your point of sale, your accounting, your stock list — talking to each other, so a number typed once stops being typed three more times.',
  },
  {
    title: 'Take the manual steps out',
    body: 'The reports somebody rebuilds by hand every Monday, the files that get emailed back and forth. Those can run themselves, including the parts that need reading and judgement.',
  },
  {
    title: 'Get off the spreadsheet',
    body: 'Move a business onto a proper system without closing for a day. Everything checked against the old records before you switch, and reversible until you are sure.',
  },
];
---

<Base
  title="Business software for Philippine companies"
  description="LMI Automata Labs builds point-of-sale, practice management and construction software for businesses in the Philippines — BIR-ready, e-wallet aware, and built to keep working when the connection drops."
  bare={false}
>
  <!-- ============ HERO ============ -->
  <section class="sheet hero">
    <div class="row">
      <div class="margin" aria-hidden="true">Manila</div>
      <div class="hero-body">
        <p class="eyebrow">Software studio &middot; Metro Manila</p>
        <h1 class="hero-title">Software your business can actually run on.</h1>
        <p class="lede">
          We build the systems Philippine companies use every day &mdash; the till at the counter,
          the payroll on Friday, the portal a client checks on a Sunday. <strong>Built here, for
          how business works here:</strong> receipts the BIR accepts, e&#8209;wallets counted
          properly, and everything still working when the internet drops.
        </p>
        <div class="hero-cta">
          <a class="btn" href="/contact/">Talk about your business</a>
          <a class="btn btn-ghost" href="/work/">See what we&rsquo;ve built</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FEATURED WORK ============ -->
  <section class="sheet block">
    <hr class="rule" />
    <div class="row block-inner">
      <div class="margin" aria-hidden="true">Work</div>
      <div>
        <div class="block-head">
          <h2 class="section-title">The work</h2>
          <p class="lede block-note">
            {liveCount} of these are running real businesses today &mdash; taking payments,
            paying staff, and keeping owners out of spreadsheets.
          </p>
        </div>

        <div class="grid-featured">
          {featured.map((project) => <ProjectCard project={project} featured />)}
        </div>

        {rest.length > 0 && (
          <div class="grid-rest">
            {rest.map((project) => <ProjectCard project={project} />)}
          </div>
        )}

        <p class="block-foot">
          <a class="btn btn-ghost" href="/work/">All projects</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="sheet block">
    <hr class="rule" />
    <div class="row block-inner">
      <div class="margin" aria-hidden="true">Services</div>
      <div>
        <div class="block-head">
          <h2 class="section-title">Not everything needs a new system</h2>
          <p class="lede block-note">
            Often the software is already there and the problem is that none of it talks.
            That work is usually faster and cheaper than building something new.
          </p>
        </div>
        <div class="svc">
          {services.map((s) => (
            <div class="svc-item">
              <h3 class="svc-title">{s.title}</h3>
              <p class="svc-body">{s.body}</p>
            </div>
          ))}
        </div>
        <p class="block-foot">
          <a class="btn btn-ghost" href="/services/">How this works</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="sheet block">
    <hr class="rule" />
    <div class="row block-inner">
      <div class="margin" aria-hidden="true">Next</div>
      <div class="cta">
        <h2 class="section-title">Tell us where the day breaks.</h2>
        <p class="lede">
          The best place to start is the part of the week everyone dreads &mdash; closing the till,
          chasing timesheets, rebuilding the same report. Describe that, and we will tell you
          honestly whether it is worth building.
        </p>
        <div class="hero-cta">
          <a class="btn" href="/contact/">Start a conversation</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3rem, 9vw, 6rem) clamp(2.5rem, 5vw, 3.5rem); }
  .hero-body { display: grid; gap: 1.5rem; justify-items: start; }
  .hero-title {
    font-weight: 800;
    font-size: clamp(2.35rem, 1.1rem + 5.2vw, 4.5rem);
    line-height: 0.99;
    letter-spacing: -0.03em;
    max-width: 16ch;
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .block { padding-block: 0 clamp(3rem, 6vw, 4.5rem); }
  .block-inner { padding-top: clamp(2.5rem, 5vw, 3.75rem); }
  .block-head { display: grid; gap: 0.85rem; margin-bottom: clamp(2rem, 4vw, 2.75rem); }
  .block-note { max-width: 54ch; }
  .block-foot { margin-top: clamp(2rem, 4vw, 2.75rem); }

  .grid-featured { display: grid; gap: clamp(2.5rem, 5vw, 3.5rem); }
  .grid-rest {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem) 2rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  @media (min-width: 62rem) {
    .grid-featured { grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr)); }
  }

  .svc { display: grid; gap: 0; }
  .svc-item { padding-block: 1.6rem; border-top: 1px solid var(--rule-soft); display: grid; gap: 0.4rem; }
  .svc-item:first-child { border-top: 0; padding-top: 0; }
  .svc-title { font-weight: 700; font-size: clamp(1.125rem, 1.05rem + 0.4vw, 1.3125rem); }
  .svc-body { color: var(--ink-2); max-width: var(--measure); }

  .cta { display: grid; gap: 1.25rem; justify-items: start; }
</style>
