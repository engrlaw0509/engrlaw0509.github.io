---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import Marquee from '../components/Marquee.astro';
import UpdateList from '../components/UpdateList.astro';
import { getProjects, allUpdates, latestPerProject } from '../lib/projects';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
const [lead, ...pair] = featured;
const liveCount = projects.filter((p) => p.data.status === 'production').length;
const updates = allUpdates(projects);
const latest = updates[0];

/** Explicitly chosen in the project's index.md — see `hero` in content.config.ts. */
const heroShot = projects.find((p) => p.data.hero && p.data.cover);

/*
 * Every figure here is measured, counted or tested — not estimated. Each one
 * names where it comes from; change it there first, then here.
 */
const stats = [
  { n: 45, unit: 'ms', label: 'Median response for Croma MNL, measured from Manila' },   // croma-mnl-pg README
  { n: 40, unit: '×', label: 'Faster than the spreadsheet system it replaced' },          // 1.8 s floor → 45 ms
  { n: 767, unit: '', label: 'Automated tests guarding Kaha before its first cafe' },     // `vitest list` in kaha
  { n: liveCount, unit: '', label: 'Products running in production today' },
];

const stack = [
  'TypeScript', 'Postgres', 'Node.js', 'Next.js', 'React', 'Astro', 'Hono', 'Drizzle',
  'Kysely', 'Supabase', 'Railway', 'Cloudflare R2', 'Resend', 'PayMongo', 'Android',
  'Installable web apps', 'Apps Script', 'n8n', 'AI agents', 'Vitest',
];
---

<Base
  title="LMI Automata Labs — Automate your business"
  bare
  description="LMI Automata Labs builds and automates the software Philippine businesses run on — point of sale, payroll, client portals and the integrations between them. Three products live in production."
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="bg-grid hero-grid" aria-hidden="true"></div>
    <div class="bg-glow" aria-hidden="true"></div>

    <div class="wrap hero-inner">
      {latest && (
        <a class="announce rise" href="/changelog/">
          <span class="announce-tag">New</span>
          <span class="announce-text">
            <strong>{latest.project.name}</strong> &middot; {latest.title}
          </span>
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
            <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      )}

      <h1 class="h-display hero-title rise" style="--d: 1">
        <span class="ink-fade">Automate your</span>
        <span class="grad-text">business.</span>
      </h1>

      <p class="lede hero-lede rise" style="--d: 2">
        We build the software Philippine companies run on &mdash; the POS at the counter,
        the payroll on Friday, the portal a client checks on a Sunday &mdash; and connect it
        to what you already use. <strong>Built here, for how business works here:</strong>
        {' '}BIR-style invoices, e&#8209;wallets counted properly, and nothing typed twice.
      </p>

      <div class="btn-row hero-cta rise" style="--d: 3">
        <a class="btn btn-lg" href="/contact/">
          Start a project
          <svg class="arrow" viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
            <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a class="btn btn-ghost btn-lg" href="/work/">Explore the products</a>
      </div>

      <ul class="proof rise" style="--d: 4">
        <li>
          <span class="status is-live"><span class="status-dot" aria-hidden="true"></span>Live</span>
          {liveCount} products in production
        </li>
        <li>45&nbsp;ms median response</li>
        <li>Built in Manila</li>
      </ul>
    </div>

    {heroShot?.data.cover && (
      <div class="wrap hero-stage rise" style="--d: 5">
        <div class="hero-shot">
          <BrowserFrame host={heroShot.data.host} large class="hero-frame">
            <Image
              src={heroShot.data.cover}
              alt={`${heroShot.data.name} — the dashboard an adviser opens every morning`}
              widths={[760, 1160, 1600, 2200]}
              sizes="(min-width: 80rem) 76rem, 94vw"
              loading="eager"
              fetchpriority="high"
            />
          </BrowserFrame>

          <!-- True facts from four products, styled as live notifications. -->
          <div class="float f-a" aria-hidden="true">
            <span class="float-icon">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="M13 3 5 13h6l-1 8 8-10h-6l1-8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            </span>
            <span><b>Croma MNL</b>45 ms median response</span>
          </div>
          <div class="float f-b" aria-hidden="true">
            <span class="float-icon">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="M12 3 4.5 6v5.5c0 4.6 3.1 8.4 7.5 9.5 4.4-1.1 7.5-4.9 7.5-9.5V6L12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m8.8 12.2 2.2 2.2 4.4-4.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span><b>Sentro</b>Encrypted backup, every night</span>
          </div>
          <div class="float f-c" aria-hidden="true">
            <span class="float-icon">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span><b>Kaha</b>767 automated tests</span>
          </div>
          <div class="float f-d" aria-hidden="true">
            <span class="float-icon">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="M4 12a8 8 0 0 1 13.7-5.6M20 12a8 8 0 0 1-13.7 5.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M18 3v3.6h-3.6M6 21v-3.6h3.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span><b>EA Builders</b>Site attendance → payroll</span>
          </div>
        </div>
      </div>
    )}
  </section>

  <!-- ============ STACK ============ -->
  <section class="stack-band" aria-label="Our stack">
    <p class="stack-h">The stack behind every product</p>
    <Marquee items={stack} />
  </section>

  <!-- ============ PRODUCTS ============ -->
  <section class="section" id="products">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Products</p>
        <h2 class="h-lg ink-fade">{projects.length} products. {liveCount} running in production.</h2>
        <p class="lede">
          Each one replaced a spreadsheet, a paper book, or a stack of apps that never spoke
          to each other &mdash; and each is still being improved every week.
        </p>
      </div>

      <div class="products">
        {lead && <div class="reveal"><ProjectCard project={lead} layout="wide" /></div>}
        {pair.length > 0 && (
          <div class="grid-2">
            {pair.map((p) => <div class="reveal"><ProjectCard project={p} /></div>)}
          </div>
        )}
        {rest.length === 1 && <div class="reveal"><ProjectCard project={rest[0]} layout="wide" /></div>}
        {rest.length > 1 && (
          <div class="grid-2">
            {rest.map((p) => <div class="reveal"><ProjectCard project={p} /></div>)}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ============ CAPABILITIES ============ -->
  <section class="section section-alt">
    <div class="bg-grid caps-grid" aria-hidden="true"></div>
    <div class="wrap">
      <div class="section-head is-center reveal">
        <p class="eyebrow">Capabilities</p>
        <h2 class="h-lg ink-fade">The building blocks behind every system</h2>
        <p class="lede">
          The same parts, assembled for a cafe, an insurance agency or a construction
          company. Often the fastest win is connecting what you already own.
        </p>
      </div>

      <div class="bento">
        <!-- POS -->
        <article class="cell edge spot span-2 reveal">
          <div class="cell-copy">
            <h3 class="cell-title">Point of sale, built to BIR rules</h3>
            <p class="cell-body">
              Sales invoices on 58&nbsp;mm thermal paper with the VAT split to the centavo,
              every e&#8209;wallet on one line, and sales that are safe to retry when the
              connection drops.
            </p>
          </div>
          <div class="viz viz-receipt" aria-hidden="true">
            <div class="rcpt">
              <p class="rcpt-h">SALES INVOICE</p>
              <p class="rcpt-sub">No. 0004213 &middot; POS 1</p>
              <div class="rcpt-rows">
                <p><span>Spanish latte</span><span>150.00</span></p>
                <p><span>Oat milk</span><span>30.00</span></p>
                <p><span>Croissant</span><span>95.00</span></p>
              </div>
              <div class="rcpt-rows is-tax">
                <p><span>VATable sales</span><span>245.54</span></p>
                <p><span>VAT 12%</span><span>29.46</span></p>
              </div>
              <p class="rcpt-total"><span>TOTAL</span><span>&#8369;275.00</span></p>
              <p class="rcpt-pay"><span>E-wallet</span><span>275.00</span></p>
            </div>
          </div>
        </article>

        <!-- Payroll -->
        <article class="cell edge spot reveal">
          <div class="cell-copy">
            <h3 class="cell-title">Payroll that fills itself</h3>
            <p class="cell-body">
              Attendance logged on site or at the counter becomes the pay run &mdash; SSS,
              PhilHealth and Pag&#8209;IBIG from the statutory tables.
            </p>
          </div>
          <div class="viz viz-pay" aria-hidden="true">
            <p class="pay-row"><span class="pay-av">RS</span><span class="pay-bar" style="--w: 92%"></span><span class="pay-h">8.0h</span></p>
            <p class="pay-row"><span class="pay-av">JL</span><span class="pay-bar" style="--w: 78%"></span><span class="pay-h">7.5h</span></p>
            <p class="pay-row"><span class="pay-av">MA</span><span class="pay-bar" style="--w: 96%"></span><span class="pay-h">8.5h</span></p>
            <p class="pay-ok">Pay run ready &middot; nothing re-typed</p>
          </div>
        </article>

        <!-- Integrations -->
        <article class="cell edge spot reveal">
          <div class="cell-copy">
            <h3 class="cell-title">Systems that talk to each other</h3>
            <p class="cell-body">
              Your POS, accounting, stock and e&#8209;wallets connected, so a figure typed once
              appears everywhere it should.
            </p>
          </div>
          <div class="viz viz-int" aria-hidden="true">
            <svg viewBox="0 0 300 150" class="int-svg">
              <path id="w1" class="wire" d="M62 34 C 110 34, 110 75, 150 75" />
              <path id="w2" class="wire" d="M62 116 C 110 116, 110 75, 150 75" />
              <path id="w3" class="wire" d="M150 75 C 190 75, 190 34, 238 34" />
              <path id="w4" class="wire" d="M150 75 C 190 75, 190 116, 238 116" />
              <circle class="packet" r="3"><animateMotion dur="2.6s" repeatCount="indefinite"><mpath href="#w1" /></animateMotion></circle>
              <circle class="packet" r="3"><animateMotion dur="3.1s" begin="0.8s" repeatCount="indefinite"><mpath href="#w2" /></animateMotion></circle>
              <circle class="packet" r="3"><animateMotion dur="2.8s" begin="0.4s" repeatCount="indefinite"><mpath href="#w3" /></animateMotion></circle>
              <circle class="packet" r="3"><animateMotion dur="3.4s" begin="1.2s" repeatCount="indefinite"><mpath href="#w4" /></animateMotion></circle>
              <g class="node"><rect x="4" y="20" width="58" height="28" rx="8" /><text x="33" y="38">POS</text></g>
              <g class="node"><rect x="4" y="102" width="58" height="28" rx="8" /><text x="33" y="120">Stock</text></g>
              <g class="node"><rect x="238" y="20" width="58" height="28" rx="8" /><text x="267" y="38">Books</text></g>
              <g class="node"><rect x="238" y="102" width="58" height="28" rx="8" /><text x="267" y="120">Wallets</text></g>
              <g class="hub"><rect x="126" y="55" width="48" height="40" rx="12" /><text x="150" y="79">sync</text></g>
            </svg>
          </div>
        </article>

        <!-- AI -->
        <article class="cell edge spot span-2 reveal">
          <div class="cell-copy">
            <h3 class="cell-title">AI that does the reading</h3>
            <p class="cell-body">
              Invoices, forms and reports read and entered for you, checked against what
              should be there, with a person approving anything that matters.
            </p>
          </div>
          <div class="viz viz-ai" aria-hidden="true">
            <div class="doc">
              <span class="doc-l" style="--w: 58%"></span>
              <span class="doc-l" style="--w: 86%"></span>
              <span class="doc-l" style="--w: 72%"></span>
              <span class="doc-l" style="--w: 90%"></span>
              <span class="doc-l" style="--w: 44%"></span>
              <span class="doc-l" style="--w: 80%"></span>
              <span class="doc-scan"></span>
            </div>
            <span class="ai-arrow">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div class="fields">
              <p><span>Supplier</span><span>Metro Dairy Co.</span></p>
              <p><span>Invoice no.</span><span>MD-20931</span></p>
              <p><span>Total</span><span>&#8369;18,450.00</span></p>
              <p class="fields-ok">Matches the order &middot; ready to approve</p>
            </div>
          </div>
        </article>

        <!-- Portals -->
        <article class="cell edge spot reveal">
          <div class="cell-copy">
            <h3 class="cell-title">Portals clients open themselves</h3>
            <p class="cell-body">
              A link in their email, no password &mdash; to see their cover, their build or
              their balance without calling you.
            </p>
          </div>
          <div class="viz viz-phone" aria-hidden="true">
            <div class="phone">
              <span class="phone-notch"></span>
              <p class="ph-h">Hello, Ana</p>
              <p class="ph-card"><span>Total cover</span><strong>&#8369;4.5M</strong></p>
              <p class="ph-card"><span>Next payment</span><strong>18 Oct</strong></p>
              <p class="ph-link">Signed in by magic link</p>
            </div>
          </div>
        </article>

        <!-- Dashboards -->
        <article class="cell edge spot reveal">
          <div class="cell-copy">
            <h3 class="cell-title">Numbers you can see live</h3>
            <p class="cell-body">
              Dashboards that move as the day does: sales by the hour, production by
              adviser, profit by project.
            </p>
          </div>
          <div class="viz viz-chart" aria-hidden="true">
            <p class="kpi"><span>Sales today</span><strong>&#8369;48,210</strong><em>+12%</em></p>
            <svg viewBox="0 0 200 64" class="spark" preserveAspectRatio="none">
              <defs>
                <linearGradient id="spark-fill" x1="0" x2="0" y1="0" y2="1">
                  <stop offset="0" stop-color="currentColor" stop-opacity=".35" />
                  <stop offset="1" stop-color="currentColor" stop-opacity="0" />
                </linearGradient>
              </defs>
              <path class="spark-area" d="M0 52 L20 46 L40 49 L60 36 L80 40 L100 28 L120 31 L140 18 L160 22 L180 10 L200 14 L200 64 L0 64 Z" />
              <path class="spark-line" d="M0 52 L20 46 L40 49 L60 36 L80 40 L100 28 L120 31 L140 18 L160 22 L180 10 L200 14" />
            </svg>
          </div>
        </article>

        <!-- Security -->
        <article class="cell edge spot reveal">
          <div class="cell-copy">
            <h3 class="cell-title">Secure by default</h3>
            <p class="cell-body">
              Built so that a mistake cannot quietly leak one customer's data to another.
            </p>
          </div>
          <ul class="viz viz-sec" aria-hidden="true">
            <li>Each business walled off from the next</li>
            <li>Every change kept on a trail</li>
            <li>Nightly encrypted backups, restore-tested</li>
          </ul>
        </article>
      </div>

      <div class="btn-row caps-foot reveal">
        <a class="btn btn-ghost" href="/services/">See how an engagement works</a>
      </div>
    </div>
  </section>

  <!-- ============ MEASURED ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head is-center reveal">
        <p class="eyebrow">Measured, not claimed</p>
        <h2 class="h-lg ink-fade">Engineering you can check</h2>
        <p class="lede">
          Numbers from the systems themselves &mdash; measured, counted or tested, never
          estimated.
        </p>
      </div>
      <div class="stats reveal">
        {stats.map((s) => (
          <div class="stat">
            <p class="stat-n">
              <span class="grad-text" data-count={s.n}>{s.n.toLocaleString('en-US')}</span>
              {s.unit && <span class="stat-u">{s.unit}</span>}
            </p>
            <p class="stat-l">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CHANGELOG ============ -->
  <section class="section section-alt">
    <div class="wrap log">
      <div class="section-head log-head reveal">
        <p class="eyebrow">Changelog</p>
        <h2 class="h-lg ink-fade">Always shipping</h2>
        <p class="lede">
          Every product here is still being worked on. The latest, across all four.
        </p>
        <a class="link-arrow" href="/changelog/">
          Full changelog
          <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
            <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
      <div class="card-surface log-list reveal">
        <UpdateList items={latestPerProject(updates, 2)} showProject />
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section">
    <div class="wrap">
      <div class="cta edge reveal">
        <div class="bg-grid" aria-hidden="true"></div>
        <div class="cta-glow" aria-hidden="true"></div>
        <p class="eyebrow">Next step</p>
        <h2 class="h-xl ink-fade cta-title">Tell us where the week breaks.</h2>
        <p class="lede cta-lede">
          The best place to start is the part of the week everyone dreads &mdash; closing the
          POS, chasing timesheets, rebuilding the same report. Describe that, and we will tell
          you honestly whether it is worth building.
        </p>
        <div class="btn-row cta-row">
          <a class="btn btn-lg" href="/contact/">
            Start a project
            <svg class="arrow" viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
              <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.7"
                stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a class="btn btn-ghost btn-lg" href="mailto:lmiautomatalabs@gmail.com">Email us</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------------- hero ---------------- */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3.5rem, 9vw, 7rem) 0;
    overflow: hidden;
  }
  .hero > .bg-grid, .hero > .bg-glow { z-index: -1; }
  .hero-grid { background-size: 64px 64px; }
  .hero-inner {
    display: grid;
    /* minmax(0, 1fr), not the implicit auto track: the announcement's nowrap
       text would otherwise widen the column past a phone screen, and
       overflow-x: clip on body would hide the cut-off silently. */
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  .announce {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 100%;
    padding: 0.35rem 0.85rem 0.35rem 0.35rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-2);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    color: var(--ink-2);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: border-color 200ms var(--ease), color 200ms var(--ease);
  }
  .announce:hover { color: var(--ink); border-color: color-mix(in srgb, var(--accent) 60%, var(--line-2)); }
  .announce-tag {
    flex: none;
    font-family: var(--f-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.55rem;
    border-radius: var(--r-pill);
    background: var(--grad);
    color: var(--on-accent);
  }
  .announce-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .announce-text strong { color: var(--ink); font-weight: 600; }
  .announce svg { flex: none; transition: transform 200ms var(--ease); }
  .announce:hover svg { transform: translateX(3px); }

  .hero-title { display: grid; }
  .hero-lede { max-width: 60ch; }
  .hero-cta { justify-content: center; margin-top: 0.25rem; }

  .proof {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .proof li { display: inline-flex; align-items: center; gap: 0.55rem; }
  .proof li + li::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--line-2);
    margin-right: 0.95rem;
  }
  /* Once the row wraps, a separator would start the second line. */
  @media (max-width: 30rem) { .proof li + li::before { display: none; } }

  /* ---------------- hero shot ---------------- */
  .hero-stage { margin-top: clamp(3rem, 7vw, 5rem); }
  .hero-shot { position: relative; max-width: 76rem; margin-inline: auto; }
  .hero-shot::before {
    content: '';
    position: absolute;
    inset: 8% 6% -6%;
    background: radial-gradient(50% 50% at 50% 50%, var(--glow), transparent 70%);
    filter: blur(40px);
    opacity: 0.55;
    z-index: -1;
  }
  /* Fade the bottom of the screenshot into the page, so it reads as a window
     into the product rather than a picture pasted on. */
  .hero-shot::after {
    content: '';
    position: absolute;
    inset: auto -1px -1px;
    height: 32%;
    background: linear-gradient(to bottom, transparent, var(--bg) 92%);
    pointer-events: none;
    z-index: 2;
  }
  .hero-shot :global(.hero-frame) { transform-origin: 50% 0%; }
  .hero-shot :global(img) { aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }

  /* Tilted back, and settling flat as it scrolls into view — where the browser
