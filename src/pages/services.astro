---
import Base from '../layouts/Base.astro';

const services = [
  {
    label: 'Integration',
    title: 'Make your systems talk to each other',
    body: 'Most businesses already own the software they need — it just does not connect. Sales sit in one place, stock in another, the accountant gets a spreadsheet at month end. We join them up so a figure entered once appears everywhere it should, with a record of every move in case anyone asks.',
    forWho: 'Best when you have more than two systems and someone is copying between them.',
  },
  {
    label: 'Automation',
    title: 'Stop doing it by hand',
    body: 'The Monday report someone rebuilds from scratch. The invoices typed in twice. The documents read one at a time to pull out three numbers. These can run on their own — including the steps that need a bit of judgement, which software can now handle.',
    forWho: 'Best when a task is repetitive, follows rules, and eats hours every week.',
  },
  {
    label: 'Migration',
    title: 'Get off the spreadsheet safely',
    body: 'Moving years of records onto a real system is the part everyone puts off, because getting it wrong is expensive. We check every row against the old file before anything is switched, keep the old version running alongside, and only cut over once you agree the numbers match.',
    forWho: 'Best when the spreadsheet has become too big, too slow, or too risky to trust.',
  },
  {
    label: 'Custom software',
    title: 'Build the thing that does not exist yet',
    body: 'Sometimes there is no product that fits, because the way you work is the reason you win. The systems in our work are all this: built for one business, around how that business actually operates, and now running it every day.',
    forWho: 'Best when off-the-shelf software almost fits but forces you to change how you work.',
  },
];

const steps = [
  {
    title: 'We talk about the week, not the software',
    body: 'What takes too long, what gets done twice, what nobody wants to be responsible for. No jargon needed — describe it the way you would to a new employee.',
  },
  {
    title: 'You get an honest answer',
    body: 'Sometimes the answer is that a cheaper tool already does this, or that the problem is not worth building for yet. We would rather say so than take the work.',
  },
  {
    title: 'We build the smallest useful thing first',
    body: 'One real part of the job, working, in your hands early — so you can tell us it is wrong before it is expensive to change.',
  },
  {
    title: 'It goes live without stopping the business',
    body: 'Old and new run side by side until the numbers agree. Nobody closes for a day to switch systems.',
  },
];
---

<Base
  title="Services"
  description="Integration, automation, data migration and custom software for Philippine businesses — from LMI Automata Labs in Metro Manila."
>
  <section class="page-head">
    <div class="wrap head-inner">
      <p class="eyebrow">What we do</p>
      <h1 class="h-xl head-title">Four ways this usually starts.</h1>
      <p class="lede">
        Not every problem needs new software. Often the fastest fix is connecting what you
        already own, or taking one manual job off someone&rsquo;s desk. Here is the range,
        cheapest first.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap svc-grid">
      {services.map((s) => (
        <div class="card-surface svc">
          <span class="svc-label">{s.label}</span>
          <h2 class="h-md">{s.title}</h2>
          <p class="muted">{s.body}</p>
          <p class="svc-for">{s.forWho}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it goes</p>
        <h2 class="h-lg">Working together, step by step</h2>
      </div>
      <ol class="steps">
        {steps.map((step, i) => (
          <li class="step">
            <span class="step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="step-body">
              <h3 class="h-md step-title">{step.title}</h3>
              <p class="muted">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta">
        <h2 class="h-lg">Not sure which of these you need?</h2>
        <p class="lede cta-lede">
          That is normal, and it is our job to work out. Describe the part of the week that
          goes wrong and we will tell you which one it is — or that it is none of them.
        </p>
        <a class="btn" href="/contact/">Start a conversation</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head { padding-block: clamp(2.5rem, 6vw, 4.5rem) 0; }
  .head-inner { display: grid; gap: 1.1rem; }
  .head-title { max-width: 20ch; }

  .svc-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .svc { display: grid; gap: 0.7rem; align-content: start; }
  .svc-label {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .svc-for {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--ink-3);
    border-top: 1px solid var(--line);
    padding-top: 0.8rem;
    margin-top: 0.25rem;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    counter-reset: none;
  }
  .step {
    display: grid;
    gap: 0.7rem;
    align-content: start;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: clamp(1.25rem, 2.5vw, 1.6rem);
  }
  .step-n {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .step-body { display: grid; gap: 0.4rem; }
  .step-title { font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.1875rem); }

  .cta {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.1rem;
    padding: clamp(2.5rem, 5vw, 3.5rem) clamp(1.25rem, 4vw, 3rem);
    background:
      radial-gradient(90% 120% at 50% 0%, var(--accent-wash), transparent 70%),
      var(--bg-tint);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .cta-lede { max-width: 54ch; }
</style>
