---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const live = projects.filter((p) => p.data.status === 'production');
const building = projects.filter((p) => p.data.status === 'building');
---

<Base
  title="Work"
  description="Point of sale, practice management and construction management — software LMI Automata Labs has built for businesses in the Philippines."
>
  <section class="page-head">
    <div class="wrap head-inner">
      <p class="eyebrow">{projects.length} projects</p>
      <h1 class="h-xl head-title">Systems running real businesses.</h1>
      <p class="lede">
        Each of these replaced a spreadsheet, a paper book, or a stack of apps that never
        spoke to each other. Open one to see the screens and what changed for the owner.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="group-head">
        <h2 class="h-md">In production</h2>
        <span class="group-count">{live.length}</span>
      </div>
      <div class="grid">
        {live.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  {building.length > 0 && (
    <section class="section section-tint">
      <div class="wrap">
        <div class="group-head">
          <h2 class="h-md">In development</h2>
          <span class="group-count">{building.length}</span>
        </div>
        <div class="grid">
          {building.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="cta">
        <h2 class="h-lg">Something similar in your business?</h2>
        <p class="lede cta-lede">
          Most of these started as one person saying the same task was eating their week.
        </p>
        <a class="btn" href="/contact/">Start a conversation</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head { padding-block: clamp(2.5rem, 6vw, 4.5rem) 0; }
  .head-inner { display: grid; gap: 1.1rem; }
  .head-title { max-width: 20ch; }

  .group-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  .group-count {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
    background: var(--surface-2);
    border-radius: var(--r-pill);
    padding: 0.15rem 0.55rem;
  }

  .grid {
    display: grid;
    gap: clamp(2.25rem, 4.5vw, 3rem) 2rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
  }

  .cta {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.1rem;
    padding: clamp(2.5rem, 5vw, 3.5rem) clamp(1.25rem, 4vw, 3rem);
    background:
      radial-gradient(90% 120% at 50% 0%, var(--accent-wash), transparent 70%),
      var(--bg-tint);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .cta-lede { max-width: 50ch; }
</style>
