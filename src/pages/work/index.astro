---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const live = projects.filter((p) => p.data.status === 'production');
const building = projects.filter((p) => p.data.status === 'building');
---

<Base
  title="Work"
  description="Point of sale, practice management, construction management — software LMI Automata Labs has built for businesses in the Philippines."
>
  <section class="sheet head">
    <div class="row">
      <div class="margin" aria-hidden="true">Work</div>
      <div class="head-body">
        <p class="eyebrow">{projects.length} projects</p>
        <h1 class="page-title">Systems running real businesses.</h1>
        <p class="lede">
          Each of these replaced a spreadsheet, a paper book, or a stack of apps that never
          spoke to each other. Open one to see the screens and what changed for the owner.
        </p>
      </div>
    </div>
  </section>

  <section class="sheet block">
    <hr class="rule" />
    <div class="row block-inner">
      <div class="margin" aria-hidden="true">In production</div>
      <div>
        <div class="grid">
          {live.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </div>
  </section>

  {building.length > 0 && (
    <section class="sheet block">
      <hr class="rule" />
      <div class="row block-inner">
        <div class="margin" aria-hidden="true">In development</div>
        <div>
          <div class="grid">
            {building.map((project) => <ProjectCard project={project} />)}
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="sheet block">
    <hr class="rule" />
    <div class="row block-inner">
      <div class="margin" aria-hidden="true">Next</div>
      <div class="cta">
        <h2 class="section-title">Something similar in your business?</h2>
        <p class="lede">
          Most of these started as one person saying the same task was eating their week.
        </p>
        <a class="btn" href="/contact/">Start a conversation</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .head { padding-block: clamp(2.75rem, 7vw, 4.5rem) clamp(2rem, 4vw, 3rem); }
  .head-body { display: grid; gap: 1.1rem; }
  .page-title {
    font-weight: 800;
    font-size: clamp(2.1rem, 1.2rem + 3.6vw, 3.5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 18ch;
  }

  .block { padding-block: 0 clamp(2.5rem, 5vw, 4rem); }
  .block-inner { padding-top: clamp(2.25rem, 4.5vw, 3.25rem); }

  .grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem) 2rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .cta { display: grid; gap: 1.1rem; justify-items: start; }
</style>
