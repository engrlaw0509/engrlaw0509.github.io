---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const sorted = projects.sort((a, b) => a.data.order - b.data.order);

  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      // Wrap around so there is always a next project to go to.
      next: sorted[(i + 1) % sorted.length],
    },
  }));
}

const { project, next } = Astro.props;
const d = project.data;
const live = d.status === 'production';
const { Content } = await render(project);

// Share this project's own screenshot rather than the studio card, cropped to
// the 1200x630 every platform expects. Projects without a cover fall back to
// the branded card in Base.
const ogImage = d.cover
  ? (await getImage({ src: d.cover, width: 1200, height: 630, fit: 'cover', format: 'png' })).src
  : undefined;
---

<Base title={d.name} description={d.summary} ogImage={ogImage}>
  <article>
    <!-- ============ HEADER ============ -->
    <section class="page-head">
      <div class="wrap head-inner">
        <p class="crumb">
          <a href="/work/">Work</a>
          <span aria-hidden="true">/</span>
          <span>{d.name}</span>
        </p>
        <div class="title-row">
          <h1 class="h-xl">{d.name}</h1>
          <span class:list={['status', live && 'is-live']}>
            {live ? 'In production' : 'In development'}
          </span>
        </div>
        <p class="sector">{d.sector}</p>
        <p class="lede">{d.summary}</p>
      </div>
    </section>

    {d.cover && (
      <section class="wrap shot-hero">
        <div class="frame frame-lg">
          <div class="frame-bar" aria-hidden="true"><span></span><span></span><span></span></div>
          <Image
            src={d.cover}
            alt={`${d.name} — main screen`}
            widths={[760, 1160, 1600]}
            sizes="(min-width: 78rem) 70rem, 94vw"
            loading="eager"
          />
        </div>
      </section>
    )}

    {d.highlights.length > 0 && (
      <section class="wrap band">
        <div class="metrics">
          {d.highlights.map((h) => (
            <div>
              <span class="metric-n">{h.value}</span>
              <span class="metric-l">{h.label}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ============ BEFORE / AFTER ============ -->
    <section class="section">
      <div class="wrap">
        <div class="story">
          <div class="card-surface story-part">
            <span class="story-tag">Before</span>
            <p class="muted">{d.problem}</p>
          </div>
          <div class="card-surface story-part is-after">
            <span class="story-tag is-good">After</span>
            <p class="story-outcome">{d.outcome}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ WHAT IT DOES ============ -->
    {d.features.length > 0 && (
      <section class="section section-tint">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow">What it does</p>
            <h2 class="h-lg">The parts that matter to the owner</h2>
          </div>
          <div class="feat-grid">
            {d.features.map((f) => (
              <div class="card-surface feat">
                <h3 class="h-md feat-title">{f.title}</h3>
                <p class="muted">{f.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ============ GALLERY ============ -->
    {d.gallery.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow">Screens</p>
            <h2 class="h-lg">A look inside</h2>
          </div>
          <div class="gallery">
            {d.gallery.map((shot, i) => (
              <figure class="gal-item">
                <div class="frame">
                  <div class="frame-bar" aria-hidden="true">
                    <span></span><span></span><span></span>
                  </div>
                  <Image
                    src={shot.src}
                    alt={shot.alt}
                    widths={[640, 1024, 1440]}
                    sizes="(min-width: 62rem) 54rem, 94vw"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </div>
                {shot.caption && <figcaption class="gal-cap">{shot.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ============ DETAIL + STACK ============ -->
    <section class="section section-tint">
      <div class="wrap detail">
        <div class="prose"><Content /></div>
        {d.stack.length > 0 && (
          <aside class="card-surface built">
            <span class="built-h">Built with</span>
            <ul class="tags">{d.stack.map((s) => <li>{s}</li>)}</ul>
          </aside>
        )}
      </div>
    </section>

    <!-- ============ NEXT ============ -->
    <section class="section">
      <div class="wrap">
        <div class="cta">
          <h2 class="h-lg">Could your business use something like this?</h2>
          <div class="btn-row">
            <a class="btn" href="/contact/">Start a conversation</a>
            {next.id !== project.id && (
              <a class="btn btn-ghost" href={`/work/${next.id}/`}>Next: {next.data.name}</a>
            )}
          </div>
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  .page-head { padding-block: clamp(2rem, 5vw, 3.5rem) 0; }
  .head-inner { display: grid; gap: 0.85rem; }
  .crumb {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    display: flex;
    gap: 0.5rem;
  }
  .crumb a { color: var(--ink-3); text-decoration: none; }
  .crumb a:hover { color: var(--accent); }
  .title-row { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; }
  .sector {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .shot-hero { margin-top: clamp(1.75rem, 3.5vw, 2.5rem); }
  .band { padding-top: clamp(1.75rem, 3.5vw, 2.5rem); }

  /* ---------------- before / after ---------------- */
  .story { display: grid; gap: 1.25rem; }
  @media (min-width: 48rem) { .story { grid-template-columns: 1fr 1fr; } }
  .story-part { display: grid; gap: 0.7rem; align-content: start; }
  .story-part.is-after {
    border-color: color-mix(in srgb, var(--accent) 30%, var(--line));
    background:
      radial-gradient(130% 100% at 0% 0%, var(--accent-wash), transparent 65%),
      var(--surface);
  }
  .story-tag {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .story-tag.is-good { color: var(--accent); }
  .story-outcome {
    color: var(--ink);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.6;
  }

  /* ---------------- features ---------------- */
  .feat-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }
  .feat { display: grid; gap: 0.5rem; align-content: start; }
  .feat-title { font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem); }

  /* ---------------- gallery ---------------- */
  .gallery { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .gal-item { margin: 0; display: grid; gap: 0.8rem; }
  .gal-cap { font-size: 0.9375rem; color: var(--ink-2); max-width: 64ch; }

  /* ---------------- detail ---------------- */
  .detail { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 62rem) { .detail { grid-template-columns: minmax(0, 1fr) 17rem; gap: 3rem; } }
  .prose { color: var(--ink-2); display: grid; gap: 1.1rem; max-width: var(--measure); }
  .prose :global(p) { margin: 0; }
  .prose :global(h2), .prose :global(h3) {
    color: var(--ink);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 1.1875rem;
    margin-top: 0.5rem;
  }
  .prose :global(ul) { margin: 0; padding-left: 1.15rem; display: grid; gap: 0.4rem; }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }

  .built { display: grid; gap: 0.8rem; align-content: start; }
  .built-h {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* ---------------- cta ---------------- */
  .cta {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.25rem;
    padding: clamp(2.5rem, 5vw, 3.5rem) clamp(1.25rem, 4vw, 3rem);
    background:
      radial-gradient(90% 120% at 50% 0%, var(--accent-wash), transparent 70%),
      var(--bg-tint);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
</style>
