---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import StatusPill from '../../components/StatusPill.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import SystemPanel from '../../components/SystemPanel.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import { getProjects, fmtMonYear, isoDay } from '../../lib/projects';

export async function getStaticPaths() {
  const sorted = await getProjects();
  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      // Wrap around so there is always a next project to go to.
      next: sorted[(i + 1) % sorted.length],
    },
  }));
}

const { project, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);

// Share this project's own screenshot rather than the studio card, cropped to
// the 1200x630 every platform expects. Projects without a cover fall back to
// the branded card in Base.
const ogImage = d.cover
  ? (await getImage({ src: d.cover, width: 1200, height: 630, fit: 'cover', format: 'png' })).src
  : undefined;

const siteHost = d.site ? new URL(d.site).host.replace(/^www\./, '') : undefined;
const lastUpdate = d.latest[0]?.date;
---

<Base title={d.name} description={d.summary} ogImage={ogImage}>
  <article>
    <!-- ============ HEADER ============ -->
    <section class="page-head proj-head">
      <div class="bg-grid" aria-hidden="true"></div>
      <div class="bg-glow" aria-hidden="true"></div>
      <div class="wrap head-inner">
        <nav class="crumb rise" aria-label="Breadcrumb">
          <a href="/work/">Products</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{d.name}</span>
        </nav>
        <div class="title-row rise" style="--d: 1">
          <h1 class="h-xl ink-fade">{d.name}</h1>
          <StatusPill status={d.status} probe={project.id} />
        </div>
        <p class="sector rise" style="--d: 1">{d.sector}</p>
        <p class="lede rise" style="--d: 2">{d.summary}</p>

        <div class="btn-row rise" style="--d: 3">
          {d.site && (
            <a class="btn" href={d.site} rel="noopener">
              Visit {siteHost}
              <svg class="arrow" viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
                <path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.7"
                  stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          )}
          <a class:list={['btn', d.site && 'btn-ghost']} href="/contact/">Build something like this</a>
        </div>

        {(d.platforms.length > 0 || lastUpdate) && (
          <dl class="meta rise" style="--d: 4">
            {d.platforms.length > 0 && (
              <div><dt>Ships as</dt><dd>{d.platforms.join(' · ')}</dd></div>
            )}
            {lastUpdate && (
              <div>
                <dt>Latest feature</dt>
                <dd><time datetime={isoDay(lastUpdate)}>{fmtMonYear(lastUpdate)}</time></dd>
              </div>
            )}
          </dl>
        )}
      </div>
    </section>

    {d.cover ? (
      <section class="wrap shot-hero rise" style="--d: 4">
        <BrowserFrame host={d.host} large vt={`shot-${project.id}`}>
          <Image
            src={d.cover}
            alt={`${d.name} — main screen`}
            widths={[760, 1160, 1600, 2200]}
            sizes="(min-width: 80rem) 76rem, 94vw"
            loading="eager"
            fetchpriority="high"
          />
        </BrowserFrame>
      </section>
    ) : d.system.length > 0 && (
      <section class="wrap shot-hero term-hero rise" style="--d: 4">
        <SystemPanel name={d.name} items={d.system} />
      </section>
    )}

    {d.highlights.length > 0 && (
      <section class="wrap band reveal">
        <div class="metrics">
          {d.highlights.map((h) => (
            <div>
              <span class="metric-n">{h.value}</span>
              <span class="metric-l">{h.label}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ============ BEFORE / AFTER ============ -->
    <section class="section">
      <div class="wrap">
        <div class="story">
          <div class="card-surface story-part reveal">
            <span class="story-tag">Before</span>
            <p class="muted">{d.problem}</p>
          </div>
          <span class="story-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
              <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8"
                stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <div class="story-part is-after edge reveal">
            <span class="story-tag is-good">After</span>
            <p class="story-outcome">{d.outcome}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ WHAT IT DOES ============ -->
    {d.features.length > 0 && (
      <section class="section section-alt">
        <div class="wrap">
          <div class="section-head reveal">
            <p class="eyebrow">What it does</p>
            <h2 class="h-lg ink-fade">The parts that matter to the owner</h2>
          </div>
          <div class="feat-grid">
            {d.features.map((f, i) => (
              <div class="feat edge spot reveal">
                <span class="feat-n">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="feat-title">{f.title}</h3>
                <p class="muted">{f.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ============ SYSTEM + LATEST FEATURES ============ -->
    {(d.latest.length > 0 || (d.cover && d.system.length > 0)) && (
      <section class="section">
        <div class:list={['wrap', 'sys', !(d.cover && d.system.length > 0) && 'is-single']}>
          {d.cover && d.system.length > 0 && (
            <div class="sys-col reveal">
              <div class="section-head sys-head">
                <p class="eyebrow">Under the hood</p>
                <h2 class="h-md">How it is built to hold up</h2>
              </div>
              <SystemPanel name={d.name} items={d.system} />
            </div>
          )}
          {d.latest.length > 0 && (
            <div class="sys-col reveal">
              <div class="section-head sys-head">
                <p class="eyebrow">Latest features</p>
                <h2 class="h-md">What is new in {d.name}</h2>
              </div>
              <div class="latest">
                {d.latest.map((f, i) => (
                  <FeatureCard title={f.title} body={f.body} date={f.date} newest={i === 0} />
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- ============ GALLERY ============ -->
    {d.gallery.length > 0 && (
      <section class="section section-alt">
        <div class="wrap">
          <div class="section-head reveal">
            <p class="eyebrow">Screens</p>
            <h2 class="h-lg ink-fade">A look inside</h2>
          </div>
          <div class="gallery">
            {d.gallery.map((shot) => (
              <figure class="gal-item reveal">
                <BrowserFrame host={d.host}>
                  <Image
                    src={shot.src}
                    alt={shot.alt}
                    widths={[640, 1024, 1440, 2000]}
                    sizes="(min-width: 80rem) 64rem, 94vw"
                    loading="lazy"
                  />
                </BrowserFrame>
                {shot.caption && <figcaption class="gal-cap">{shot.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ============ DETAIL + STACK ============ -->
    <section class="section">
      <div class="wrap detail">
        <div class="prose reveal"><Content /></div>
        {d.stack.length > 0 && (
          <aside class="card-surface built reveal">
            <span class="built-h">Built with</span>
            <ul class="tags">{d.stack.map((s) => <li>{s}</li>)}</ul>
          </aside>
        )}
      </div>
    </section>

    <!-- ============ NEXT ============ -->
    <section class="section next-section">
      <div class="wrap">
        <div class="cta edge reveal">
          <div class="bg-grid" aria-hidden="true"></div>
          <h2 class="h-lg ink-fade">Could your business use something like this?</h2>
          <div class="btn-row">
            <a class="btn" href="/contact/">Start a project</a>
            {next.id !== project.id && (
              <a class="btn btn-ghost" href={`/work/${next.id}/`}>
                Next: {next.data.name}
                <svg class="arrow" viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
                  <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.7"
                    stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  .proj-head { padding-bottom: 0; }
  .crumb {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    display: flex;
    gap: 0.5rem;
  }
  .crumb a { color: var(--ink-3); text-decoration: none; }
  .crumb a:hover { color: var(--accent); }
  .crumb [aria-current] { color: var(--ink-2); }
  .title-row { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .sector {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.25rem;
    margin: 0.5rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .meta div { display: grid; gap: 0.2rem; }
  .meta dt {
    font-family: var(--f-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .meta dd { margin: 0; color: var(--ink-2); font-size: 0.9375rem; }

  .shot-hero { margin-top: clamp(2.25rem, 5vw, 3.5rem); }
  .shot-hero :global(img) { aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
  .term-hero { max-width: 56rem; }
  .band { padding-top: clamp(2rem, 4vw, 3rem); }

  /* ---------------- before / after ---------------- */
  .story { display: grid; gap: 1rem; align-items: stretch; }
  @media (min-width: 52rem) {
    .story { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 1.25rem; }
  }
  .story-part {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    padding: clamp(1.4rem, 3vw, 2.1rem);
    border-radius: var(--r-xl);
  }
  .story-part.is-after {
    background:
      radial-gradient(120% 100% at 0% 0%, var(--accent-wash), transparent 60%) padding-box,
      linear-gradient(var(--surface), var(--surface)) padding-box,
      linear-gradient(160deg, color-mix(in srgb, var(--accent) 60%, transparent), var(--line) 50%, color-mix(in srgb, var(--accent-3) 40%, transparent)) border-box;
    box-shadow: 0 30px 70px -40px var(--glow);
  }
  .story-arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    justify-self: center;
    align-self: center;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    background: var(--surface);
    color: var(--accent);
    transform: rotate(90deg);
  }
  @media (min-width: 52rem) { .story-arrow { transform: none; } }
  .story-tag {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .story-tag.is-good { color: var(--accent); }
  .story-outcome {
    color: var(--ink);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.6;
  }

  /* ---------------- features ---------------- */
  .feat-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }
  .feat {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: clamp(1.35rem, 2.5vw, 1.75rem);
    border-radius: var(--r-xl);
  }
  .feat-n {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .feat-title { font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem); font-weight: 650; letter-spacing: -0.025em; }

  /* ---------------- system + latest features ---------------- */
  .sys { display: grid; gap: 2.5rem; }
  @media (min-width: 64rem) {
    .sys { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; align-items: start; }
    .sys.is-single { grid-template-columns: minmax(0, 46rem); }
  }
  .sys-col { display: grid; gap: 0; align-content: start; }
  .sys-head { margin-bottom: 1.5rem; gap: 0.6rem; }
  .latest { display: grid; gap: 0.85rem; }

  /* ---------------- gallery ---------------- */
  .gallery { display: grid; gap: clamp(2.5rem, 5vw, 4rem); max-width: 68rem; }
  .gal-item { margin: 0; display: grid; gap: 0.9rem; }
  .gal-cap { font-size: 0.9375rem; color: var(--ink-2); max-width: 66ch; }

  /* ---------------- detail ---------------- */
  .detail { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 62rem) { .detail { grid-template-columns: minmax(0, 1fr) 18rem; gap: 3rem; } }
  .built { display: grid; gap: 0.8rem; align-content: start; }
  .built-h {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* ---------------- next ---------------- */
  .next-section { padding-top: 0; }
  .cta {
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.4rem;
    padding: clamp(2.75rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 3rem);
    border-radius: var(--r-xl);
    overflow: hidden;
  }
  .cta > .bg-grid {
    z-index: -1;
    -webkit-mask-image: radial-gradient(ellipse 60% 80% at 50% 100%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 60% 80% at 50% 100%, #000 20%, transparent 75%);
  }
  .cta .btn-row { justify-content: center; }
</style>
