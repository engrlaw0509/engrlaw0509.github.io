---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const sorted = projects.sort((a, b) => a.data.order - b.data.order);

  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      // Wrap around so there is always a next project to go to.
      next: sorted[(i + 1) % sorted.length],
    },
  }));
}

const { project, next } = Astro.props;
const d = project.data;
const live = d.status === 'production';
const { Content } = await render(project);
---

<Base title={d.name} description={d.summary}>
  <!-- ============ HEADER ============ -->
  <article>
    <section class="sheet head">
      <div class="row">
        <div class="margin" aria-hidden="true">{d.sector}</div>
        <div class="head-body">
          <p class="crumb"><a href="/work/">Work</a> <span aria-hidden="true">/</span> {d.name}</p>
          <div class="head-title">
            <h1 class="page-title">{d.name}</h1>
            <span class:list={['status', live && 'is-live']}>
              {live ? 'In production' : 'In development'}
            </span>
          </div>
          <p class="lede">{d.summary}</p>
        </div>
      </div>
    </section>

    {d.cover && (
      <section class="sheet cover-wrap">
        <div class="shot">
          <Image
            src={d.cover}
            alt={`${d.name} — main screen`}
            widths={[640, 1024, 1440, 1920]}
            sizes="(min-width: 78rem) 68rem, 94vw"
            loading="eager"
          />
        </div>
      </section>
    )}

    <!-- ============ PROBLEM / OUTCOME ============ -->
    <section class="sheet block">
      <hr class="rule" />
      <div class="row block-inner">
        <div class="margin" aria-hidden="true">The story</div>
        <div class="story">
          <div class="story-part">
            <h2 class="story-h">Before</h2>
            <p class="story-p">{d.problem}</p>
          </div>
          <div class="story-part">
            <h2 class="story-h">After</h2>
            <p class="story-p is-outcome">{d.outcome}</p>
          </div>
        </div>

        {d.highlights.length > 0 && (
          <div class="figures highlights">
            {d.highlights.map((h) => (
              <div>
                <span class="n">{h.value}</span>
                <span class="l">{h.label}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- ============ WHAT IT DOES ============ -->
    {d.features.length > 0 && (
      <section class="sheet block">
        <hr class="rule" />
        <div class="row block-inner">
          <div class="margin" aria-hidden="true">What it does</div>
          <div class="feat">
            {d.features.map((f) => (
              <div class="feat-item">
                <h3 class="feat-title">{f.title}</h3>
                <p class="feat-body">{f.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ============ GALLERY ============ -->
    {d.gallery.length > 0 && (
      <section class="sheet block">
        <hr class="rule" />
        <div class="row block-inner">
          <div class="margin" aria-hidden="true">Screens</div>
          <div class="gallery">
            {d.gallery.map((shot, i) => (
              <figure class="gal-item">
                <div class="shot">
                  <Image
                    src={shot.src}
                    alt={shot.alt}
                    widths={[640, 1024, 1440]}
                    sizes="(min-width: 62rem) 52rem, 94vw"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </div>
                {shot.caption && <figcaption class="gal-cap">{shot.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ============ FREE PROSE (optional, from the .md body) ============ -->
    <section class="sheet block">
      <hr class="rule" />
      <div class="row block-inner">
        <div class="margin" aria-hidden="true">Detail</div>
        <div>
          <div class="prose"><Content /></div>
          {d.stack.length > 0 && (
            <div class="built">
              <h3 class="built-h">Built with</h3>
              <ul class="stack">{d.stack.map((s) => <li>{s}</li>)}</ul>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- ============ NEXT ============ -->
    <section class="sheet block">
      <hr class="rule" />
      <div class="row block-inner">
        <div class="margin" aria-hidden="true">Next</div>
        <div class="cta">
          <h2 class="section-title">Could your business use something like this?</h2>
          <div class="cta-row">
            <a class="btn" href="/contact/">Start a conversation</a>
            {next.id !== project.id && (
              <a class="btn btn-ghost" href={`/work/${next.id}/`}>
                Next: {next.data.name}
              </a>
            )}
          </div>
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  .head { padding-block: clamp(2rem, 5vw, 3.25rem) clamp(1.5rem, 3vw, 2.25rem); }
  .head-body { display: grid; gap: 1rem; }
  .crumb {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .crumb a { color: var(--ink-3); text-decoration: none; }
  .crumb a:hover { color: var(--accent); }
  .head-title { display: flex; align-items: baseline; gap: 0.9rem; flex-wrap: wrap; }
  .page-title {
    font-weight: 800;
    font-size: clamp(2.2rem, 1.2rem + 4vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.032em;
  }

  .cover-wrap { padding-block: 0 clamp(1rem, 2vw, 1.5rem); }

  .block { padding-block: 0 clamp(2.5rem, 5vw, 3.75rem); }
  .block-inner { padding-top: clamp(2.25rem, 4.5vw, 3.25rem); }

  .story { display: grid; gap: clamp(1.75rem, 3.5vw, 2.5rem); }
  @media (min-width: 48rem) { .story { grid-template-columns: 1fr 1fr; } }
  .story-part { display: grid; gap: 0.55rem; align-content: start; }
  .story-h {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .story-p { color: var(--ink-2); }
  .story-p.is-outcome {
    color: var(--ink);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
  }
  .highlights { margin-top: clamp(2rem, 4vw, 2.75rem); }

  .feat { display: grid; gap: 0; }
  .feat-item { padding-block: 1.5rem; border-top: 1px solid var(--rule-soft); display: grid; gap: 0.4rem; }
  .feat-item:first-child { border-top: 0; padding-top: 0; }
  .feat-title { font-weight: 700; font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem); }
  .feat-body { color: var(--ink-2); max-width: var(--measure); }

  .gallery { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .gal-item { margin: 0; display: grid; gap: 0.7rem; }
  .gal-cap { font-size: 0.9375rem; color: var(--ink-3); max-width: 60ch; }

  .prose { color: var(--ink-2); display: grid; gap: 1rem; max-width: var(--measure); }
  .prose :global(p) { margin: 0; }
  .prose :global(h2),
  .prose :global(h3) { color: var(--ink); font-weight: 700; font-size: 1.125rem; margin-top: 0.5rem; }
  .prose :global(ul) { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.35rem; }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }

  .built { margin-top: clamp(2rem, 4vw, 2.5rem); display: grid; gap: 0.7rem; }
  .built-h {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .cta { display: grid; gap: 1.1rem; justify-items: start; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
