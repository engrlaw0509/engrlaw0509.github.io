---
/**
 * A project's engineering facts, set as a terminal session.
 *
 * It is real text in a <dl>, not a picture of text: screen readers get the
 * facts, and the ✓ / ◐ glyphs carry a spoken equivalent. Every line comes from
 * the project's `system` field, which has to be true today.
 */
interface Item {
  key: string;
  value: string;
  state: 'ok' | 'wip' | 'info';
}
interface Props {
  name: string;
  items: Item[];
  compact?: boolean;
}

const { name, items, compact = false } = Astro.props;
const cmd = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const glyph = { ok: '✓', wip: '◐', info: '·' } as const;
const spoken = { ok: 'shipped', wip: 'in progress', info: '' } as const;
---

<div class:list={['term', compact && 'is-compact']}>
  <div class="term-bar" aria-hidden="true">
    <span class="frame-dots"><i></i><i></i><i></i></span>
    <span class="term-title">{cmd} — system</span>
  </div>
  <div class="term-body">
    <p class="term-cmd" aria-hidden="true"><span class="term-prompt">$</span> {cmd} status</p>
    <dl class="term-list">
      {items.map((item) => (
        <div class="term-row">
          <dt class="term-key">{item.key}</dt>
          <dd class="term-val">
            <span>{item.value}</span>
            <span class:list={['term-state', `is-${item.state}`]} aria-hidden="true">
              {glyph[item.state]}
            </span>
            {spoken[item.state] && <span class="sr-only">({spoken[item.state]})</span>}
          </dd>
        </div>
      ))}
    </dl>
    <p class="term-cmd" aria-hidden="true">
      <span class="term-prompt">$</span> <span class="term-caret"></span>
    </p>
  </div>
</div>

<style>
  .term {
    background: var(--term-bg);
    border: 1px solid var(--term-line);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    color: var(--term-ink);
    font-family: var(--f-mono);
    font-size: 0.8125rem;
    line-height: 1.55;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.8rem;
    background: var(--term-bar);
    border-bottom: 1px solid var(--term-line);
  }
  .term-title {
    flex: 1;
    text-align: center;
    margin-right: 2.6rem;
    font-size: 0.6875rem;
    color: var(--term-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .term-body { padding: 1rem 1.1rem 1.1rem; display: grid; gap: 0.6rem; }
  .term-cmd { color: var(--term-ink); }
  .term-prompt { color: var(--term-ok); margin-right: 0.35rem; }

  .term-list { margin: 0; display: grid; gap: 0.45rem; }
  .term-row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    align-items: baseline;
  }
  .term-key { color: var(--term-key); }
  .term-key::after { content: ':'; color: var(--term-dim); }
  .term-val {
    margin: 0;
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--term-ink);
  }
  .term-state { flex: none; font-weight: 500; }
  .term-state.is-ok { color: var(--term-ok); }
  .term-state.is-wip { color: var(--term-wip); }
  .term-state.is-info { color: var(--term-dim); }

  .term-caret {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--term-ink);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .term-caret { animation: none; } }

  .is-compact { font-size: 0.75rem; }
  .is-compact .term-row { grid-template-columns: 5.75rem minmax(0, 1fr); }

  @media (max-width: 30rem) {
    .term-row { grid-template-columns: 1fr; gap: 0; }
    .term-body { padding: 0.9rem; }
  }
</style>
