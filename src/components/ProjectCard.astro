---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Wider card that eager-loads — used for the lead item. */
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { name, sector, summary, status, cover, highlights } = project.data;
const href = `/work/${project.id}/`;
const live = status === 'production';
---

<article class:list={['card', featured && 'is-featured']}>
  <a class="card-link" href={href}>
    <div class="frame card-frame">
      <div class="frame-bar" aria-hidden="true"><span></span><span></span><span></span></div>
      {cover ? (
        <Image
          src={cover}
          alt={`${name} — product screenshot`}
          widths={[480, 760, 1120]}
          sizes={featured ? '(min-width: 62rem) 46rem, 92vw' : '(min-width: 62rem) 24rem, 92vw'}
          loading="lazy"
        />
      ) : (
        <div class="placeholder" role="img" aria-label={`${name} — screenshot not yet available`}>
          <span class="placeholder-name">{name}</span>
          <span class="placeholder-note">Screenshot coming</span>
        </div>
      )}
    </div>

    <div class="card-body">
      <div class="card-head">
        <h3 class="card-name">{name}</h3>
        <span class:list={['status', live && 'is-live']}>
          {live ? 'In production' : 'In development'}
        </span>
      </div>
      <p class="card-sector">{sector}</p>
      <p class="card-summary">{summary}</p>

      {featured && highlights.length > 0 && (
        <ul class="card-points">
          {highlights.slice(0, 3).map((h) => (
            <li><strong>{h.value}</strong> {h.label}</li>
          ))}
        </ul>
      )}

      <span class="card-more">
        See the project
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="none">
          <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  .card { display: flex; }
  .card-link {
    display: grid;
    gap: 1.15rem;
    align-content: start;
    text-decoration: none;
    color: inherit;
    width: 100%;
  }

  .card-frame { transition: box-shadow 180ms ease, transform 180ms ease, border-color 180ms ease; }
  .card-link:hover .card-frame {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .card-frame, .card-link:hover .card-frame { transition: none; transform: none; }
  }

  .card-frame :global(img) {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
  }
  .is-featured .card-frame :global(img) { aspect-ratio: 16 / 9; }

  .placeholder {
    aspect-ratio: 16 / 10;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.45rem;
    background:
      radial-gradient(120% 90% at 50% 0%, var(--accent-wash), transparent 70%),
      var(--surface-2);
  }
  .is-featured .placeholder { aspect-ratio: 16 / 9; }
  .placeholder-name {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(1.2rem, 1rem + 1vw, 1.75rem);
    letter-spacing: -0.03em;
    color: var(--ink-2);
  }
  .placeholder-note {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .card-body { display: grid; gap: 0.55rem; }
  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .card-name {
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.6rem);
    font-weight: 700;
  }
  .card-link:hover .card-name { color: var(--accent); }
  .card-sector {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .card-summary { color: var(--ink-2); max-width: 48ch; }
  .is-featured .card-summary { font-size: 1.0625rem; max-width: 56ch; }

  .card-points {
    list-style: none;
    margin: 0.35rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .card-points strong {
    font-family: var(--f-display);
    font-weight: 700;
    color: var(--ink);
  }

  .card-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--accent);
    margin-top: 0.25rem;
  }
  .card-more svg { transition: transform 180ms ease; }
  .card-link:hover .card-more svg { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) { .card-link:hover .card-more svg { transform: none; } }
</style>
