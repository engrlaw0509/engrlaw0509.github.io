---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StatusPill from './StatusPill.astro';
import BrowserFrame from './BrowserFrame.astro';
import SystemPanel from './SystemPanel.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /**
   * `wide`  — text beside the screenshot; the lead card on the homepage.
   * `tall`  — screenshot above the text; the default.
   */
  layout?: 'wide' | 'tall';
  eager?: boolean;
}

const { project, layout = 'tall', eager = false } = Astro.props;
const d = project.data;
const href = `/work/${project.id}/`;
const sizes =
  layout === 'wide'
    ? '(min-width: 64rem) 50rem, 92vw'
    : '(min-width: 64rem) 40rem, 92vw';
---

<article class:list={['pcard', 'edge', 'spot', `is-${layout}`]}>
  <div class="pcard-media">
    {d.cover ? (
      <BrowserFrame host={d.host} vt={`shot-${project.id}`} class="pcard-frame">
        <Image
          src={d.cover}
          alt={`${d.name} — product screenshot`}
          widths={[520, 820, 1200, 1600]}
          sizes={sizes}
          loading={eager ? 'eager' : 'lazy'}
        />
      </BrowserFrame>
    ) : (
      <div class="pcard-term">
        <SystemPanel name={d.name} items={d.system.slice(0, 6)} compact />
      </div>
    )}
  </div>

  <div class="pcard-body">
    <div class="pcard-head">
      <h3 class="pcard-name">
        {/* The ::after of this link covers the whole card, so the card is one
            target while its accessible name stays just the product name. */}
        <a class="pcard-link" href={href}>{d.name}</a>
      </h3>
      <StatusPill status={d.status} probe={project.id} />
    </div>
    <p class="pcard-sector">{d.sector}</p>
    <p class="pcard-summary">{d.summary}</p>

    {d.highlights.length > 0 && (
      <ul class="pcard-points">
        {d.highlights.slice(0, 3).map((h) => (
          <li><strong>{h.value}</strong><span>{h.label}</span></li>
        ))}
      </ul>
    )}

    <span class="pcard-more" aria-hidden="true">
      Explore {d.name}
      <svg viewBox="0 0 16 16" width="15" height="15" fill="none">
        <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6"
          stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </div>
</article>

<style>
  .pcard {
    position: relative;
    display: grid;
    border-radius: var(--r-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 260ms var(--ease), box-shadow 260ms var(--ease);
  }
  .pcard:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 70px -36px var(--glow), var(--shadow);
  }
  .pcard:has(.pcard-link:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .pcard, .pcard:hover { transition: none; transform: none; }
  }

  /* ---------------- media ---------------- */
  .pcard-media {
    position: relative;
    padding: clamp(1rem, 2.4vw, 1.75rem) clamp(1rem, 2.4vw, 1.75rem) 0;
    background:
      radial-gradient(90% 80% at 50% 0%, var(--glow-a), transparent 70%),
      var(--bg-2);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  /* The screenshot rises out of the card's lower edge rather than sitting in
     a box — only its top corners are rounded. */
  .pcard-media :global(.pcard-frame) {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom: 0;
    margin-bottom: -1px;
    transition: transform 400ms var(--ease);
    transform-origin: 50% 100%;
  }
  .pcard:hover .pcard-media :global(.pcard-frame) { transform: translateY(-4px) scale(1.012); }
  .pcard-media :global(img) {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }
  .pcard-term { padding-bottom: clamp(1rem, 2.4vw, 1.75rem); }
  @media (prefers-reduced-motion: reduce) {
    .pcard:hover .pcard-media :global(.pcard-frame) { transform: none; }
  }

  /* ---------------- body ---------------- */
  .pcard-body {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: clamp(1.25rem, 2.6vw, 1.85rem);
  }
  .pcard-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .pcard-name {
    font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.75rem);
    font-weight: 650;
    letter-spacing: -0.035em;
  }
  .pcard-link { color: var(--ink); text-decoration: none; }
  .pcard-link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .pcard-link:focus-visible { outline: none; }
  .pcard-sector {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .pcard-summary { color: var(--ink-2); max-width: 54ch; }

  .pcard-points {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pcard-points li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
    padding: 0.35rem 0.65rem;
    border-radius: var(--r-pill);
    background: var(--surface-2);
    border: 1px solid var(--line);
  }
  .pcard-points strong {
    font-family: var(--f-display);
    font-weight: 650;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .pcard-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--accent);
    margin-top: 0.5rem;
  }
  .pcard-more svg { transition: transform 200ms var(--ease); }
  .pcard:hover .pcard-more svg { transform: translateX(3px); }

  /* ---------------- wide ---------------- */
  @media (min-width: 64rem) {
    .is-wide { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); }
    .is-wide .pcard-media {
      order: 2;
      border-bottom: 0;
      border-left: 1px solid var(--line);
      padding: 2.25rem 0 0 2.25rem;
      display: flex;
      align-items: flex-end;
    }
    /* Bleeds off the right edge too, so it reads as a window into the product. */
    .is-wide .pcard-media :global(.pcard-frame) {
      width: 100%;
      border-right: 0;
      border-top-right-radius: 0;
    }
    .is-wide .pcard-body { align-content: center; padding: 2.75rem; gap: 0.75rem; }
    .is-wide .pcard-name { font-size: clamp(1.75rem, 1.2rem + 1.2vw, 2.4rem); }
    .is-wide .pcard-summary { font-size: 1.0625rem; }
    .is-wide .pcard-term { padding: 0 2.25rem 2.25rem 0; width: 100%; }
  }
</style>
