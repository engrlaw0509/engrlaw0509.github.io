---
/**
 * Interactive services diagram.
 *
 * Deliberately CSS-only: the four views are radio inputs plus sibling
 * selectors, so it works with JavaScript off or blocked, it is keyboard
 * navigable for free (arrow keys move through a radio group), and there is no
 * script that can fail and leave the section empty.
 *
 * Every view is rendered into the DOM and one is shown, rather than one stage
 * being rewired per selection — that keeps the CSS simple enough to be obviously
 * correct, at the cost of a little markup.
 *
 * Each service answers the same three questions — what we build, the problem
 * it solves, who it is for — and points at one product where it was really
 * done. Every example must be true of a product on this site; check its
 * index.md before changing one.
 */
const services = [
  {
    id: 'integration',
    tab: 'Integration',
    title: 'Make your systems talk to each other',
    build:
      'Links between the software you already pay for — point of sale, accounting, stock, ' +
      'online orders, e-wallets and calendars — so a figure entered once appears everywhere ' +
      'it should.',
    problem:
      'Sales sit in one system and stock in another, and someone re-types figures between ' +
      'them. Mistakes creep in, and the accountant gets a spreadsheet at month end.',
    who: 'Businesses running more than two systems, where someone copies figures between them.',
    example: {
      text:
        "Croma MNL's POS, admin panel, members' app and website share one database, so a sale " +
        "at the counter counts down stock by ingredient and adds the member's points.",
      href: '/work/croma-mnl/',
      label: 'See Croma MNL',
    },
    inputs: ['Point of sale', 'Accounting', 'Stock list', 'Online orders'],
    outputs: ['One set of numbers', 'Nothing typed twice', 'A trail of every change'],
  },
  {
    id: 'automation',
    tab: 'Automation',
    title: 'Stop doing it by hand',
    build:
      'Jobs that run without anyone pressing a button: scheduled reports and reminders, ' +
      'payroll from attendance, billing, and steps that read documents and pull out the ' +
      'figures — with a person approving anything that matters.',
    problem:
      'The Monday report rebuilt from scratch, invoices typed in twice, reminders someone ' +
      'has to remember to send: hours every week on work that follows the same rules.',
    who: 'Teams with a task that is repetitive, follows rules and eats hours every week.',
    example: {
      text:
        "At EA Builders, the crew marked present on site fills the pay run by itself, and a " +
        "whole period's payslips print six to a page.",
      href: '/work/ea-builders/',
      label: 'See EA Builders',
    },
    inputs: ['The Monday report', 'Invoices', 'Documents to read', 'Reminders to send'],
    outputs: ['Runs on a schedule', 'Ready before you ask', 'Hours back every week'],
  },
  {
    id: 'migration',
    tab: 'Migration',
    title: 'Get off the spreadsheet safely',
    build:
      'A move from spreadsheets, paper or a tool you have outgrown onto a proper database — ' +
      'every row checked against the old records, with the old version kept running until ' +
      'you agree the numbers match.',
    problem:
      'The spreadsheet has become too big, too slow or too risky to trust, but moving years ' +
      'of records is the job everyone puts off, because getting it wrong is expensive.',
    who: 'Businesses that started on spreadsheets or paper and have outgrown them.',
    example: {
      text:
        'Croma MNL moved off Google Sheets onto Postgres: 8,204 rows across 50 tables checked ' +
        'before the switch, and screens that took about two seconds now answer in 45 ms.',
      href: '/work/croma-mnl/',
      label: 'See Croma MNL',
    },
    inputs: ['Years of spreadsheets', 'Paper records', 'A tool you outgrew'],
    outputs: ['One real database', 'Checked row by row', 'Reversible until you are sure'],
  },
  {
    id: 'custom',
    tab: 'Custom software',
    title: 'Build the thing that does not exist yet',
    build:
      'A complete system built around how your business works — web apps, client portals, ' +
      'point of sale and payroll, and apps that install on the phone or tablet you already use.',
    problem:
      'Off-the-shelf software almost fits, but forces you to change the way you work — and the ' +
      'way you work is the reason you win.',
    who: 'Businesses whose way of working no product supports, from a coffee shop to an insurance agency or a builder.',
    example: {
      text:
        'Sentro runs the practice of Philippine financial advisers, from the morning’s ' +
        'follow-ups to the race to MDRT, built around how agencies here actually work.',
      href: '/work/sentro/',
      label: 'See Sentro',
    },
    inputs: ['How you actually work', 'The bit no product fits', 'Your own rules'],
    outputs: ['A system built round you', 'Yours to change', 'Running the business'],
  },
];
---

<div class="diagram">
  {services.map((s, i) => (
    <input
      type="radio"
      name="service"
      id={`svc-${s.id}`}
      class="picker"
      checked={i === 0}
    />
  ))}

  <div class="tabs" role="group" aria-label="Choose a service">
    {services.map((s) => (
      <label class="tab" for={`svc-${s.id}`}>{s.tab}</label>
    ))}
  </div>

  <div class="views">
    {services.map((s) => (
      <div class:list={['view', `view-${s.id}`]}>
        <div class="stage">
          <div class="bg-grid stage-grid" aria-hidden="true"></div>
          <div class="col">
            <span class="col-h">What you have now</span>
            <ul class="nodes">
              {s.inputs.map((n) => <li class="node">{n}</li>)}
            </ul>
          </div>

          <div class="wire" aria-hidden="true"><span class="dot"></span></div>

          <div class="hub">
            <span class="hub-ring" aria-hidden="true"></span>
            <span class="hub-mark" aria-hidden="true"></span>
            <span class="hub-l">{s.tab}</span>
          </div>

          <div class="wire" aria-hidden="true"><span class="dot"></span></div>

          <div class="col">
            <span class="col-h">What you get</span>
            <ul class="nodes">
              {s.outputs.map((n) => <li class="node is-out">{n}</li>)}
            </ul>
          </div>
        </div>

        <div class="detail">
          <h3 class="h-md">{s.title}</h3>
          <dl class="facts">
            <div class="fact"><dt>What we build</dt><dd>{s.build}</dd></div>
            <div class="fact"><dt>The problem it solves</dt><dd>{s.problem}</dd></div>
            <div class="fact"><dt>Who it is for</dt><dd>{s.who}</dd></div>
          </dl>
          <p class="example">
            <span class="example-k">From our work</span>
            <span class="example-t">{s.example.text}</span>
            <a class="link-arrow" href={s.example.href}>
              {s.example.label}
              <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
                <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </p>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .diagram { display: grid; gap: 1.5rem; }

  /* Off-screen but still focusable, so the group stays keyboard navigable. */
  .picker {
    position: absolute;
    width: 1px; height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* ---------------- tabs ---------------- */
  /* Four pills do not fit one phone row, and letting them wrap freely left a
     ragged right edge. An even two-column grid below 40rem keeps every row
     flush; above that they sit in one segmented control. */
  .tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  @media (min-width: 40rem) {
    .tabs {
      display: inline-flex;
      justify-self: start;
      gap: 0.25rem;
      padding: 0.3rem;
      border-radius: var(--r-pill);
      background: var(--surface);
      border: 1px solid var(--line);
    }
  }
  .tab {
    cursor: pointer;
    user-select: none;
    text-align: center;
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.6rem 1.1rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-2);
    transition:
      border-color 170ms var(--ease),
      color 170ms var(--ease),
      background-color 170ms var(--ease),
      box-shadow 170ms var(--ease),
      transform 110ms var(--ease);
  }
  @media (min-width: 40rem) {
    .tab { border-color: transparent; background: transparent; }
  }
  .tab:hover { color: var(--ink); }
  .tab:active { transform: scale(0.97); }

  /* ---------------- views ---------------- */
  .view { display: none; }
  .views { display: grid; }

  /* Selected tab + matching view. One pair per service. */
  #svc-integration:checked ~ .tabs .tab[for='svc-integration'],
  #svc-automation:checked  ~ .tabs .tab[for='svc-automation'],
  #svc-migration:checked   ~ .tabs .tab[for='svc-migration'],
  #svc-custom:checked      ~ .tabs .tab[for='svc-custom'] {
    background: var(--grad);
    border-color: transparent;
    color: var(--on-accent);
    box-shadow: 0 8px 22px -10px var(--glow);
  }
  #svc-integration:checked ~ .views .view-integration,
  #svc-automation:checked  ~ .views .view-automation,
  #svc-migration:checked   ~ .views .view-migration,
  #svc-custom:checked      ~ .views .view-custom {
    display: grid;
    gap: 1.5rem;
    /* `display` cannot be transitioned, so the incoming panel animates instead.
       Deliberately no fill-mode: if the animation never runs the panel is simply
       visible, rather than stuck at opacity 0. */
    animation: view-in 320ms var(--ease);
  }

  @keyframes view-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    #svc-integration:checked ~ .views .view-integration,
    #svc-automation:checked  ~ .views .view-automation,
    #svc-migration:checked   ~ .views .view-migration,
    #svc-custom:checked      ~ .views .view-custom { animation: none; }
    .tab:active { transform: none; }
  }
  /* Visible focus ring on the active tab when driven by keyboard. */
  #svc-integration:focus-visible ~ .tabs .tab[for='svc-integration'],
  #svc-automation:focus-visible  ~ .tabs .tab[for='svc-automation'],
  #svc-migration:focus-visible   ~ .tabs .tab[for='svc-migration'],
  #svc-custom:focus-visible      ~ .tabs .tab[for='svc-custom'] {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ---------------- stage ---------------- */
  .stage {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 1.25rem;
    align-items: center;
    padding: clamp(1.25rem, 3.5vw, 2.75rem);
    background:
      radial-gradient(70% 90% at 50% 50%, var(--glow-a), transparent 70%),
      var(--surface);
    border: 1px solid var(--line-2);
    border-radius: var(--r-xl);
    overflow: hidden;
  }
  .stage-grid {
    z-index: -1;
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, #000 20%, transparent 80%);
    mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, #000 20%, transparent 80%);
  }
  @media (min-width: 60rem) {
    .stage { grid-template-columns: 1fr auto auto auto 1fr; gap: 0 1.25rem; }
  }

  .col { display: grid; gap: 0.7rem; align-content: start; }
  .col-h {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .nodes { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .node {
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.65rem 0.9rem;
    border-radius: var(--r);
    border: 1px solid var(--line);
    background: var(--bg-2);
    color: var(--ink-2);
  }
  .node.is-out {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-2));
    color: var(--ink);
    font-weight: 600;
  }

  /* The connector, echoing the circuit traces in the mark. A packet runs
     along it so the direction of the work is obvious. */
  .wire {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 3rem;
    overflow: hidden;
  }
  .wire::before {
    content: '';
    position: absolute;
    inset: 0 auto;
    width: 2px;
    background: linear-gradient(to bottom, transparent, var(--cyan), transparent);
  }
  .wire .dot {
    position: absolute;
    top: 0;
    width: 0.5rem; height: 0.5rem;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 10px 2px var(--cyan);
  }
  @media (prefers-reduced-motion: no-preference) {
    .wire .dot { animation: travel-y 1.8s var(--ease) infinite; }
  }
  @keyframes travel-y {
    from { transform: translateY(-0.5rem); opacity: 0; }
    30%  { opacity: 1; }
    to   { transform: translateY(3rem); opacity: 0; }
  }
  @media (min-width: 60rem) {
    .wire { min-height: 0; height: 2rem; width: 5rem; }
    .wire::before {
      inset: auto 0;
      width: auto; height: 2px;
      background: linear-gradient(to right, transparent, var(--cyan), transparent);
    }
    .wire .dot { top: auto; left: 0; }
    @media (prefers-reduced-motion: no-preference) {
      .wire .dot { animation-name: travel-x; }
    }
  }
  @keyframes travel-x {
    from { transform: translateX(-0.5rem); opacity: 0; }
    30%  { opacity: 1; }
    to   { transform: translateX(5rem); opacity: 0; }
  }

  /* ---------------- hub ---------------- */
  .hub {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    padding: 1.1rem 1.35rem;
    border-radius: var(--r-xl);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--line));
    background: var(--bg);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 7%, transparent), 0 20px 60px -20px var(--glow);
    justify-self: center;
  }
  .hub-ring {
    position: absolute;
    inset: -6px;
    border-radius: calc(var(--r-xl) + 6px);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hub-ring { animation: breathe 2.8s ease-in-out infinite; }
  }
  @keyframes breathe {
    50% { transform: scale(1.06); opacity: 0.3; }
  }
  /* A background, not an <img>, so it follows the site theme rather than the
     OS one. */
  .hub-mark {
    width: 64px;
    height: 44px;
    background: url('/brand/mark-wide-light.png') center / contain no-repeat;
  }
  :global([data-theme='light']) .hub-mark { background-image: url('/brand/mark-wide.png'); }
  .hub-l {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    text-align: center;
  }

  /* ---------------- detail ---------------- */
  .detail { display: grid; gap: 1.1rem; }

  /* The same three questions for every service, side by side on a wide
     screen and stacked on a phone. */
  .facts {
    margin: 0;
    display: grid;
    gap: 1rem 2rem;
  }
  @media (min-width: 52rem) { .facts { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .fact { display: grid; gap: 0.35rem; align-content: start; }
  .fact dt {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .fact dd { margin: 0; color: var(--ink-2); }

  .example {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
    padding: 1rem 1.15rem;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    background: var(--surface);
    max-width: 75ch;
  }
  .example-k {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .example-t { color: var(--ink); }
  /* Comfortable to tap on a phone without changing how it looks. */
  .example .link-arrow { padding-block: 0.65rem; margin-block: -0.65rem; }
</style>
