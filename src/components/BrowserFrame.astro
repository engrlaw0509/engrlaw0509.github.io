---
/**
 * A browser window around a screenshot. The address bar shows `host` — only
 * ever the host the screenshot genuinely came from.
 *
 * `vt` names the frame for a cross-document view transition, so the same
 * screenshot on a card and on the project page morphs between the two. A name
 * must be unique on a page, or the browser skips the transition entirely.
 */
interface Props {
  host?: string;
  large?: boolean;
  vt?: string;
  class?: string;
}

const { host, large = false, vt, class: cls } = Astro.props;
---

<div
  class:list={['frame', large && 'frame-lg', cls]}
  style={vt ? `view-transition-name: ${vt}` : undefined}
>
  <div class="frame-bar" aria-hidden="true">
    <span class="frame-dots"><i></i><i></i><i></i></span>
    {host && (
      <span class="frame-url">
        <svg viewBox="0 0 16 16" width="11" height="11" fill="none">
          <rect x="3.5" y="7" width="9" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.4" />
          <path d="M5.5 7V5.2a2.5 2.5 0 0 1 5 0V7" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <span>{host}</span>
      </span>
    )}
    <span class="frame-spacer"></span>
  </div>
  <slot />
</div>
